# opendesk self-host configuration, read by docker-compose.yml next to it.
#
# The installer (https://opendesk.sh/install.sh) writes this file with fresh
# secrets. From a checkout, `make selfhost-env` does the same. Either way the
# secrets are generated once and never regenerated: keep a copy of this file
# somewhere other than this machine.

# ── Release ────────────────────────────────────────────────────────────────
# Pinned, never "latest", so `docker compose up -d` always brings up the same
# version. Upgrade by changing it, then `docker compose pull && docker compose up -d`.
OPENDESK_VERSION=latest
# OPENDESK_IMAGE=ghcr.io/opendesk/opendesk
# REALTIME_IMAGE=ghcr.io/opendesk/realtime

# ── Address ────────────────────────────────────────────────────────────────
# The hostname people open. Its DNS must point at this machine, with ports 80
# and 443 reachable, for Caddy to get a certificate. "localhost" uses Caddy's
# local CA; ":80" serves plain HTTP behind another TLS-terminating proxy.
OPENDESK_DOMAIN=localhost
OPENDESK_URL=https://localhost
OPENDESK_GATEWAY_URL=wss://localhost/socket
# Caddy global options. Set an email so the ACME account can be reached about
# expiring certificates.
CADDY_GLOBAL_OPTIONS=
# HTTP_PORT=80
# HTTPS_PORT=443
# OPENDESK_CADDYFILE=./deploy/caddy/Caddyfile

# ── Secrets (generated; never change them on a running install) ────────────
# Signs every session and realtime token; shared with the gateway. >= 32 bytes.
AUTH_SECRET=
# Encrypts mailbox credentials, OAuth tokens and webhook secrets (32 bytes hex).
# LOSING IT MAKES EVERY STORED MAILBOX CREDENTIAL UNREADABLE. Back it up.
CREDENTIALS_KEY=
# The gateway's Phoenix secret.
SECRET_KEY_BASE=
# Authenticates the gateway to the embedded NATS.
NATS_TOKEN=
# Authenticates POST /v1/inbound/email (forwarded mail from a relay or worker).
INBOUND_SECRET=
POSTGRES_PASSWORD=

# ── Accounts ───────────────────────────────────────────────────────────────
# After the first owner has signed up, set false to close registration.
SIGNUP_ENABLED=true

# ── Platform email (verification, password resets, invitations) ────────────
# log prints messages to `docker compose logs opendesk`; use smtp for real mail.
MAIL_DRIVER=log
MAIL_FROM=opendesk <notifications@localhost>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# starttls (587) | tls (465) | none
SMTP_TLS=starttls

# ── Inbound email ──────────────────────────────────────────────────────────
# Forwarding addresses are <token>@INBOUND_DOMAIN. To receive mail directly,
# point an MX record for INBOUND_DOMAIN at this host, set INBOUND_SMTP_ADDR=:2525
# and add smtp-inbound to COMPOSE_PROFILES (publishes port INBOUND_SMTP_PORT, 25).
INBOUND_DOMAIN=in.localhost
INBOUND_SMTP_ADDR=
# INBOUND_SMTP_PORT=25

# ── Attachments ────────────────────────────────────────────────────────────
# local keeps files in the opendesk-data volume. s3 works with AWS S3,
# Cloudflare R2, or the bundled minio profile.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Optional services ──────────────────────────────────────────────────────
# Comma separated: minio, smtp-inbound, ollama
COMPOSE_PROFILES=

# ── Sign-in providers and mailbox connections (optional) ───────────────────
# Redirect URIs to register with each provider (provider = google, microsoft, github, oidc):
#   sign-in:   https://<your domain>/v1/auth/oauth/<provider>/callback
#   mailboxes: https://<your domain>/v1/mailboxes/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=SSO

# ── AI (optional) ──────────────────────────────────────────────────────────
# No key = AI features off. Self-hosted instances have no plans or credits.
# anthropic | openai (any OpenAI-compatible endpoint: OpenAI, Azure, Ollama,
# vLLM, LM Studio) | none. Empty = detected from the keys below.
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Empty = the provider's default models.
AI_MODEL=
AI_FAST_MODEL=
# Semantic search: voyage | openai | none (Postgres full-text search).
EMBEDDINGS_DRIVER=
VOYAGE_API_KEY=
EMBEDDINGS_MODEL=
# Decisions (triage, answer bot relevance, ai_decide conditions): typesafe |
# llm | none. Empty = typesafe with TYPESAFE_API_KEY, else llm, else none.
# Without a TypeSafe key every feature keeps working on the LLM path.
DECISIONS_PROVIDER=
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
# Fully local: add ollama to COMPOSE_PROFILES and set
#   AI_PROVIDER=openai  OPENAI_BASE_URL=http://ollama:11434/v1  OPENAI_API_KEY=ollama
#   AI_MODEL=llama3.1:8b  EMBEDDINGS_DRIVER=openai  EMBEDDINGS_MODEL=nomic-embed-text
# (or run the installer with --ollama). The models are pulled on first start.
# Integrations (Settings, Integrations). Most products sign in with no setup.
# Slack only accepts apps registered in advance: create one with the redirect URL
# <API_URL>/v1/integrations/oauth/callback and set its client here.
MCP_SLACK_CLIENT_ID=
MCP_SLACK_CLIENT_SECRET=

# ── Bot protection and product analytics (optional) ────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Server-side PostHog. Empty sends nothing anywhere.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Browser-side PostHog for the web app.
WEB_POSTHOG_KEY=
WEB_POSTHOG_HOST=
