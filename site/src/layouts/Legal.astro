---
/**
 * Long-form legal pages. The table of contents comes from the page's own
 * section list so headings and anchors stay in one place.
 */
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
  toc: { id: string; label: string }[];
}
const { title, description, updated, toc } = Astro.props;
---
<Layout title={title} description={description}>
  <section class="border-b border-line">
    <div class="container-page pt-16 pb-12 md:pt-24 md:pb-16">
      <div class="eyebrow">Legal</div>
      <h1 class="display mt-5 text-[40px] sm:text-[56px] text-fg">{title}</h1>
      <p class="mt-5 text-[15px] text-muted">Last updated {updated}</p>
    </div>
  </section>
  <div class="container-page grid gap-12 py-14 md:py-20 lg:grid-cols-[220px_1fr] lg:gap-20">
    <nav class="hidden lg:block" aria-label="On this page">
      <div class="sticky top-24">
        <div class="eyebrow mb-4">On this page</div>
        <ol class="space-y-2 text-[13.5px]">
          {toc.map((t) => <li><a href={`#${t.id}`} class="text-muted transition-colors hover:text-fg">{t.label}</a></li>)}
        </ol>
      </div>
    </nav>
    <article class="prose-od max-w-[720px]">
      <slot />
    </article>
  </div>
</Layout>
