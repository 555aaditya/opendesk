---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import CopyCommand from '../components/CopyCommand.astro';
import SectionHead from '../components/SectionHead.astro';
import CodeTabs from '../components/CodeTabs.astro';
import InboxMock from '../components/mock/InboxMock.astro';
import MailboxMock from '../components/mock/MailboxMock.astro';
import ChatMock from '../components/mock/ChatMock.astro';
import KbMock from '../components/mock/KbMock.astro';
import AutomationMock from '../components/mock/AutomationMock.astro';
import SlaMock from '../components/mock/SlaMock.astro';
import ReportsMock from '../components/mock/ReportsMock.astro';
import PresenceMock from '../components/mock/PresenceMock.astro';
import CTA from '../components/CTA.astro';
import { LINKS, SITE } from '../lib/site';
import { PRO_PRICE } from '../lib/pricing';
import AiMock from '../components/mock/AiMock.astro';
import AnswerBotMock from '../components/mock/AnswerBotMock.astro';
import { CREATE_TICKET, WEBHOOK, REALTIME } from '../lib/samples';


const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'opendesk',
  applicationCategory: 'BusinessApplication',
  applicationSubCategory: 'Help desk software',
  operatingSystem: 'Web, Linux (self-hosted)',
  url: SITE.url,
  description: SITE.description,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  codeRepository: LINKS.github,
  offers: [
    { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD', description: '1 mailbox, 1 team member, every feature' },
    { '@type': 'Offer', name: 'Pro', price: String(PRO_PRICE), priceCurrency: 'USD', description: 'Per user per month, everything unlimited' },
    { '@type': 'Offer', name: 'Self-hosted', price: '0', priceCurrency: 'USD' },
  ],
};

const steps = [
  {
    n: '01',
    title: 'Bring your mailboxes',
    body: 'Forward support@ to your opendesk address, or connect Google, Microsoft 365 or any IMAP account. Replies go out from your own mailbox, so customers see your address.',
  },
  {
    n: '02',
    title: 'Add chat and a help center',
    body: 'Drop the widget on your site and publish articles to a help center. Chats and emails land in the same inbox as tickets.',
  },
  {
    n: '03',
    title: 'Work it together, live',
    body: 'Invite your team, set roles, SLAs and rules. Every change reaches every screen as it happens, so nobody answers the same customer twice.',
  },
];
---
<Layout title="opendesk · The open-source helpdesk" jsonLd={softwareJsonLd}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-grid fade-mask opacity-80" aria-hidden="true"></div>
    <div class="container-page relative pt-14 sm:pt-20 md:pt-24">
      <div class="mx-auto max-w-3xl text-center">
        <a href={LINKS.github} class="rise inline-flex h-8 items-center gap-2 rounded-full border border-line bg-bg pl-1.5 pr-3 text-[13px] text-muted transition-colors hover:text-fg">
          <span class="inline-flex h-5 items-center rounded-full bg-fg px-2 font-mono text-[10.5px] font-medium text-bg">Apache-2.0</span>
          Open source, on GitHub
          <Icon name="arrowRight" size={13} />
        </a>
        <h1 class="rise display mt-7 text-[44px] sm:text-[64px] md:text-[80px] text-fg" style="--d:60ms">
          The helpdesk<br class="hidden sm:block" /> you can own.
        </h1>
        <p class="rise lede mx-auto mt-6 max-w-[600px] text-[17px] sm:text-[19px] leading-[1.55]" style="--d:120ms">
          Shared inboxes, live chat, a knowledge base and AI that drafts in your voice, in any language your customers write. Use opendesk Cloud, or run it on your own servers with one command.
        </p>
        <div class="rise mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" style="--d:180ms">
          <a href={LINKS.signup} class="btn btn-primary btn-lg w-full sm:w-auto">Start for free<Icon name="arrowRight" size={16} /></a>
          <CopyCommand class="w-full sm:w-[452px]" />
        </div>
        <p class="rise mt-4 text-[13px] text-subtle" style="--d:220ms">Free forever for one mailbox. Self-hosted is free and unlimited.</p>
      </div>

      <div class="rise relative mx-auto mt-14 md:mt-20 max-w-[1180px]" style="--d:260ms">
        <InboxMock />
      </div>
    </div>
  </section>

  <!-- Principles strip -->
  <section class="container-page mt-16 md:mt-20">
    <div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-4">
      {[
        ['Same code, everywhere', 'Cloud and self-hosted run one codebase.'],
        ['Your mailbox, your address', 'Replies leave from your own email account.'],
        ['Live by default', 'Every change lands on every screen at once.'],
        ['API-first', 'The app uses the same public API you do.'],
      ].map(([t, d]) => (
        <div class="reveal bg-bg p-5 md:p-6">
          <div class="text-[14.5px] font-medium text-fg">{t}</div>
          <div class="mt-1.5 text-[13.5px] leading-relaxed text-muted">{d}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="container-page mt-28 md:mt-36">
    <SectionHead eyebrow="Features" title="Everything support does,<br/>in one calm place." lede="Email, chat and your help center become one queue of tickets, with the rules, targets and numbers that keep it moving." />

    <div class="mt-12 md:mt-16 grid gap-4 md:grid-cols-3">
      <!-- Shared inbox -->
      <a href="/features/#inbox" class="reveal group card md:col-span-2 overflow-hidden p-6 md:p-8 transition-colors hover:border-fg/25">
        <div class="grid gap-8 md:grid-cols-[1fr_1.1fr] md:items-center">
          <div>
            <Icon name="inbox" size={20} class="text-fg" />
            <h3 class="mt-4 text-[22px] font-semibold tracking-[-0.02em] text-fg">Shared inbox</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">Every mailbox and channel in one list. Assign, tag, snooze, merge and reply from your own address, with internal notes alongside.</p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-[14px] font-medium text-fg">Explore the inbox<Icon name="arrowRight" size={14} class="transition-transform group-hover:translate-x-0.5" /></span>
          </div>
          <MailboxMock />
        </div>
      </a>

      <!-- Live chat -->
      <a href="/features/#chat" class="reveal group card flex flex-col overflow-hidden p-6 md:p-8 transition-colors hover:border-fg/25" style="--d:60ms">
        <Icon name="chat" size={20} class="text-fg" />
        <h3 class="mt-4 text-[22px] font-semibold tracking-[-0.02em] text-fg">Live chat</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">A light widget for your site, with signed identities for logged-in users.</p>
        <div class="mt-7 flex-1"><ChatMock /></div>
      </a>

      <!-- Knowledge base -->
      <a href="/features/#knowledge-base" class="reveal group card flex flex-col p-6 md:p-8 transition-colors hover:border-fg/25">
        <Icon name="book" size={20} class="text-fg" />
        <h3 class="mt-4 text-[22px] font-semibold tracking-[-0.02em] text-fg">Knowledge base</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">Collections and articles on a public help center, searchable from the widget.</p>
        <div class="mt-7"><KbMock /></div>
      </a>

      <!-- Automations and SLAs -->
      <a href="/features/#automations" class="reveal group card md:col-span-2 p-6 md:p-8 transition-colors hover:border-fg/25" style="--d:60ms">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="max-w-md">
            <Icon name="zap" size={20} class="text-fg" />
            <h3 class="mt-4 text-[22px] font-semibold tracking-[-0.02em] text-fg">Automations and SLAs</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">Route, tag and prioritise on arrival. Put first-reply and resolution targets on every priority, and see breaches before they happen.</p>
          </div>
        </div>
        <div class="mt-7 grid gap-4 lg:grid-cols-2">
          <AutomationMock />
          <SlaMock />
        </div>
      </a>

      <!-- Reports -->
      <a href="/features/#reports" class="reveal group card flex flex-col p-6 md:p-8 transition-colors hover:border-fg/25">
        <Icon name="chart" size={20} class="text-fg" />
        <h3 class="mt-4 text-[22px] font-semibold tracking-[-0.02em] text-fg">Reports and CSAT</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">Volume, response medians, SLA breaches and satisfaction, by day, channel and agent.</p>
        <div class="mt-7"><ReportsMock /></div>
      </a>

      <!-- Realtime -->
      <a href="/features/#realtime" class="reveal group card flex flex-col p-6 md:p-8 transition-colors hover:border-fg/25" style="--d:60ms">
        <Icon name="radio" size={20} class="text-fg" />
        <h3 class="mt-4 text-[22px] font-semibold tracking-[-0.02em] text-fg">Realtime and presence</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">See who is viewing and who is replying. No refresh, no double answers.</p>
        <div class="mt-7"><PresenceMock /></div>
      </a>

      <!-- API -->
      <a href="/features/#api" class="reveal group card flex flex-col p-6 md:p-8 transition-colors hover:border-fg/25" style="--d:120ms">
        <Icon name="braces" size={20} class="text-fg" />
        <h3 class="mt-4 text-[22px] font-semibold tracking-[-0.02em] text-fg">API and webhooks</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-muted">A documented REST API with scoped keys, signed webhooks and a realtime socket.</p>
        <div class="mt-7 rounded-2xl border border-line bg-raised p-4 font-mono text-[11.5px] leading-[1.9] shadow-card" aria-hidden="true">
          {[
            ['POST', '/v1/tickets', '201'],
            ['PATCH', '/v1/tickets/{id}', '200'],
            ['GET', '/v1/events?since=1041', '200'],
            ['POST', '/v1/realtime/token', '200'],
          ].map(([m, p, s]) => (
            <div class="flex items-center gap-3">
              <span class="w-11 text-fg font-medium">{m}</span>
              <span class="truncate text-muted">{p}</span>
              <span class="ml-auto inline-flex items-center gap-1.5 text-subtle"><span class="size-1.5 rounded-full bg-ok"></span>{s}</span>
            </div>
          ))}
          <div class="mt-2 border-t border-line-soft pt-2 text-subtle">webhook <span class="text-fg">ticket.updated</span> delivered in 84ms</div>
        </div>
      </a>
    </div>
  </section>

  <!-- AI -->
  <section id="ai" class="container-page mt-28 md:mt-36">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-end lg:gap-16">
      <SectionHead eyebrow="AI" title="AI that writes<br/>like your team." />
      <div class="reveal" style="--d:60ms">
        <p class="lede text-[17px] md:text-[18.5px] leading-[1.6]">Drafts in your voice, summaries, a copilot and triage, built into the inbox. Answer customers worldwide in their own language. Every suggestion is yours to review.</p>
      </div>
    </div>
    <div class="reveal mt-12 rounded-[24px] border border-line bg-surface-2 bg-dots p-4 sm:p-8 md:p-10" style="--d:80ms">
      <div class="mx-auto grid max-w-[980px] gap-6 md:grid-cols-[1.35fr_1fr] md:items-center md:gap-10">
        <AiMock />
        <div class="space-y-6">
          <AnswerBotMock />
          <ul class="mx-auto grid max-w-[300px] gap-2.5 text-[13.5px] text-fg/85">
            {[
              ['globe', 'Translation both ways, 13 widget languages'],
              ['zap', 'Auto-triage: tags, priority, sentiment'],
              ['search', 'Semantic search across tickets and articles'],
              ['lock', 'Never used to train models'],
            ].map(([icon, t]) => <li class="flex gap-2.5"><Icon name={icon as 'globe'} size={15} class="mt-0.5 shrink-0 text-fg" />{t}</li>)}
          </ul>
        </div>
      </div>
    </div>
    <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
      <p class="text-[14px] text-muted">Drafts, summaries, copilot, triage, translation, answer bot and semantic search. Paid for in <a href="/pricing/#ai-credits" class="text-fg underline decoration-line underline-offset-4 hover:decoration-fg">AI credits</a>.</p>
      <a href="/features/#ai" class="inline-flex items-center gap-1.5 text-[14.5px] font-medium text-fg hover:underline underline-offset-4">How opendesk uses AI<Icon name="arrowRight" size={14} /></a>
    </div>
  </section>

  <!-- Self-host band -->
  <section class="mt-28 md:mt-36">
    <div class="container-page">
      <div class="relative overflow-hidden rounded-[28px] bg-[#0a0a0a] dark:bg-[#141414] text-white ring-1 ring-white/10">
        <div class="pointer-events-none absolute inset-0 opacity-[0.5] [background-image:radial-gradient(rgba(255,255,255,0.09)_1px,transparent_1px)] [background-size:18px_18px] [mask-image:radial-gradient(ellipse_80%_70%_at_70%_40%,#000_20%,transparent_75%)]" aria-hidden="true"></div>
        <div class="relative grid gap-12 p-7 sm:p-10 md:p-14 lg:grid-cols-[1fr_1.1fr] lg:items-center">
          <div class="reveal">
            <div class="font-mono text-[12px] uppercase tracking-[0.06em] text-white/50">Open source</div>
            <h2 class="display mt-4 text-[34px] sm:text-[44px] md:text-[52px]">Self-hosted in one command.</h2>
            <p class="mt-5 max-w-lg text-[17px] leading-[1.6] text-white/65">The same code that runs opendesk Cloud. One Go binary, the realtime gateway and Postgres behind Caddy on your own domain, with HTTPS handled for you.</p>
            <ul class="mt-7 space-y-3 text-[15px] text-white/80">
              {[
                'Postgres is the only dependency. No Redis, no Kafka.',
                'Your data and your customers’ email stay on your servers.',
                'Apache-2.0. Read it, change it, run it anywhere.',
              ].map((b) => (
                <li class="flex gap-3"><Icon name="check" size={17} class="mt-0.5 shrink-0 text-white" />{b}</li>
              ))}
            </ul>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="/self-hosting/" class="btn btn-lg bg-white text-[#0a0a0a] hover:bg-white/90">Self-hosting guide<Icon name="arrowRight" size={16} /></a>
              <a href={LINKS.github} class="btn btn-lg text-white ring-1 ring-white/20 hover:bg-white/10"><Icon name="github" size={16} />Star on GitHub</a>
            </div>
          </div>
          <div class="reveal" style="--d:100ms">
            <div class="overflow-hidden rounded-2xl bg-[#111] ring-1 ring-white/12 shadow-[0_40px_80px_-30px_rgba(0,0,0,0.9)]">
              <div class="flex h-10 items-center gap-1.5 border-b border-white/10 px-4">
                <span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span>
                <span class="ml-3 font-mono text-[11px] text-white/40">~/opendesk</span>
              </div>
              <div class="p-5 font-mono text-[12.5px] leading-[1.9] sm:text-[13px]">
                <div class="flex gap-2"><span class="text-white/40">$</span><span class="break-all text-white">curl -fsSL https://opendesk.sh/install.sh | sh</span></div>
                <div class="term-lines mt-2 text-white/55">
                  <div><span class="text-white/35">·</span> Finding the newest release</div>
                  <div><span class="text-[#22c55e]">✓</span> Release files verified against SHA256SUMS</div>
                  <div><span class="text-[#22c55e]">✓</span> Wrote .env, docker-compose.yml, Caddyfile and opendesk-ctl</div>
                  <div><span class="text-white/35">·</span> Pulling images</div>
                  <div><span class="text-[#22c55e]">✓</span> Containers started</div>
                  <div><span class="text-[#22c55e]">✓</span> opendesk is up</div>
                  <div class="mt-3 text-white">  Open: https://desk.example.com</div>
                </div>
              </div>
            </div>
            <CopyCommand tone="inverse" class="mt-4" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="container-page mt-28 md:mt-36">
    <SectionHead eyebrow="How it works" title="Live in an afternoon." lede="No migration project. Point your mail at opendesk, add the widget, invite the team." />
    <ol class="mt-12 md:mt-16 grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-3">
      {steps.map((s, i) => (
        <li class="reveal bg-bg p-6 md:p-8" style={`--d:${i * 70}ms`}>
          <div class="font-mono text-[12px] text-subtle">{s.n}</div>
          <h3 class="mt-8 text-[20px] font-semibold tracking-[-0.02em] text-fg">{s.title}</h3>
          <p class="mt-2.5 text-[15px] leading-relaxed text-muted">{s.body}</p>
        </li>
      ))}
    </ol>
    <div class="reveal mt-4 flex flex-col gap-3 rounded-2xl border border-line bg-surface-2 p-5 font-mono text-[12.5px] sm:flex-row sm:items-center sm:gap-6">
      <span class="text-subtle">forwarding</span>
      <span class="text-fg">support@northwind.io</span>
      <Icon name="arrowRight" size={14} class="hidden sm:block text-subtle" />
      <span class="text-fg">acme-x7k2@in.opendesk.sh</span>
      <span class="sm:ml-auto inline-flex items-center gap-2 text-muted"><span class="size-1.5 rounded-full bg-ok"></span>Receiving</span>
    </div>
  </section>

  <!-- API teaser -->
  <section class="container-page mt-28 md:mt-36">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
      <SectionHead eyebrow="Developers" title="Built on the API you get." lede="The web app talks to the same public REST API you can call. Scoped API keys, idempotent creates, cursor pagination, signed webhooks and a realtime socket with replay.">
        <ul class="mt-8 grid gap-3 text-[14.5px] text-muted">
          {[
            ['key', 'API keys scoped to tickets, contacts, KB, settings or realtime'],
            ['webhook', 'Webhooks signed with HMAC-SHA256, with delivery history'],
            ['refresh', 'Events numbered per workspace, replayable for 7 days'],
            ['fileText', 'OpenAPI 3.1 spec, generated from the server'],
          ].map(([icon, t]) => (
            <li class="flex gap-3"><Icon name={icon as 'key'} size={17} class="mt-0.5 shrink-0 text-fg" />{t}</li>
          ))}
        </ul>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={`${LINKS.docs}/api/`} class="btn btn-primary">Read the API docs<Icon name="arrowRight" size={15} /></a>
          <a href={LINKS.apiReference} class="btn btn-ghost">API reference</a>
        </div>
      </SectionHead>
      <div class="reveal min-w-0" style="--d:80ms">
        <CodeTabs id="home-code" tabs={[
          { label: 'Create a ticket', lang: 'bash', code: CREATE_TICKET },
          { label: 'Webhook', lang: 'http', code: WEBHOOK },
          { label: 'Realtime', lang: 'js', code: REALTIME },
        ]} />
      </div>
    </div>
  </section>

  <!-- Pricing teaser -->
  <section class="container-page mt-28 md:mt-36">
    <SectionHead eyebrow="Pricing" title="Free to start. One price to grow." align="center" lede="Every feature on every plan, AI included. Plans differ only in limits." />
    <div class="mx-auto mt-12 grid max-w-5xl gap-4 md:grid-cols-3">
      {[
        { name: 'Free', price: '$0', unit: 'forever', body: '1 mailbox, 1 team member and 50 AI credits a month.', href: LINKS.signup, cta: 'Start for free', dark: false },
        { name: 'Pro', price: `$${PRO_PRICE}`, unit: 'per user / month', body: 'Unlimited mailboxes and members, 1,000 AI credits per user. Viewers are free.', href: LINKS.signup, cta: 'Start for free', dark: true },
        { name: 'Self-hosted', price: '$0', unit: 'free, unlimited', body: 'Your servers and your data, with your own AI key or a local model.', href: '/self-hosting/', cta: 'Self-host opendesk', dark: false },
      ].map((p, i) => (
        <div class={`reveal relative flex flex-col rounded-2xl p-7 ${p.dark ? 'bg-inverse text-inverse-fg' : 'card'}`} style={`--d:${i * 60}ms`}>
          <div class={`text-[15px] font-medium ${p.dark ? '' : 'text-fg'}`}>{p.name}</div>
          <div class="mt-5 flex items-baseline gap-1.5">
            <span class={`text-[44px] font-semibold tracking-[-0.04em] ${p.dark ? '' : 'text-fg'}`}>{p.price}</span>
            <span class={`text-[14px] ${p.dark ? 'opacity-70' : 'text-muted'}`}>{p.unit}</span>
          </div>
          <p class={`mt-2 flex-1 text-[14.5px] leading-relaxed ${p.dark ? 'opacity-70' : 'text-muted'}`}>{p.body}</p>
          <a href={p.href} class={p.dark ? 'btn mt-7 w-full bg-inverse-fg text-inverse hover:opacity-90' : 'btn btn-ghost mt-7 w-full'}>{p.cta}</a>
        </div>
      ))}
    </div>
    <p class="reveal mt-6 text-center text-[14px] text-muted"><a href="/pricing/" class="underline decoration-line underline-offset-4 hover:decoration-fg">Compare plans and AI credits</a></p>
  </section>

  <CTA />
</Layout>
