---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CopyCommand from '../components/CopyCommand.astro';
import CTA from '../components/CTA.astro';
import { LINKS } from '../lib/site';

// What the installer does, in the order it does it (deploy/install/install.sh).
const installSteps = [
  ['Checks for Docker', 'On Linux it offers to run Docker’s own installer, after asking. On macOS it points you to Docker Desktop.'],
  ['Writes one directory', 'Everything lives in /opt/opendesk by default. It writes nowhere else.'],
  ['Generates every secret', 'AUTH_SECRET, CREDENTIALS_KEY and the rest, written to .env with mode 0600.'],
  ['Pins a release', 'It resolves the newest release once and pins it, never “latest”, and verifies each file against SHA256SUMS.'],
  ['Starts the stack', 'docker compose pull and up, then waits while the first boot applies the database migrations.'],
];

const services = [
  { name: 'opendesk', icon: 'cpu', role: 'Go API, background workers and the web app, in one binary. Runs NATS embedded, so there is no broker to operate.' },
  { name: 'realtime', icon: 'radio', role: 'Elixir gateway for live updates, presence and typing. Holds no database connection.' },
  { name: 'postgres', icon: 'database', role: 'All data, the background job queue and the event log. The only stateful dependency.' },
  { name: 'caddy', icon: 'lock', role: 'HTTPS with automatic certificates. Routes /socket to realtime and everything else to opendesk.' },
] as const;

const ctl = [
  ['status', 'Containers, health and the running version'],
  ['logs [service]', 'Follow logs for opendesk, realtime, postgres or caddy'],
  ['backup [dir]', 'Database dump, data volume and .env into a timestamped folder'],
  ['restore <backup>', 'Put a backup back, with the app stopped while it runs'],
  ['upgrade [version]', 'Back up, then move to a release. Migrations run on boot'],
];
---
<Layout title="Self-hosting" description="Run opendesk on your own server with one command: the Go API, the realtime gateway and Postgres behind Caddy with automatic HTTPS. Free forever, Apache-2.0, same code as opendesk Cloud.">
  <PageHero label="Self-hosting" title="Your server.<br/>Your data. One command." lede="opendesk Cloud and self-hosted opendesk are the same code. Install it on any Linux machine with Docker, on your own domain, with HTTPS from the first request.">
    <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
      <CopyCommand class="w-full sm:w-[460px]" />
      <a href={`${LINKS.docs}/self-hosting/`} class="btn btn-ghost btn-lg">Read the guide<Icon name="arrowRight" size={15} /></a>
    </div>
  </PageHero>

  <!-- Architecture -->
  <section class="container-page py-20 md:py-28">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
      <div class="reveal">
        <div class="label">What you run</div>
        <h2 class="h-section mt-4">Four containers, one domain.</h2>
        <p class="lede mt-5 text-[17px] leading-[1.65]">No Redis, no Kafka, no search cluster. Background jobs and the event log live in Postgres, and the message bus runs inside the opendesk binary.</p>
      </div>
      <div class="reveal" style="--d:80ms">
        <!-- Request flow, drawn with boxes and rules -->
        <div class="rounded-[8px] border border-line bg-surface-2 bg-dots p-5 sm:p-8" aria-label="Architecture: browsers reach Caddy, which routes /socket to realtime and everything else to opendesk; opendesk uses Postgres and publishes events to realtime over NATS.">
          <div class="mx-auto flex max-w-[460px] flex-col items-center">
            <div class="flex w-full items-center justify-center gap-2 rounded-[6px] border border-line bg-raised px-4 py-3 text-[13px] text-fg shadow-card">
              <Icon name="globe" size={15} />Browsers, the widget and your API clients
            </div>
            <span class="h-6 w-px bg-fg/30"></span>
            <div class="flex w-full items-center justify-between gap-3 rounded-[6px] bg-fg px-4 py-3 text-bg">
              <span class="inline-flex items-center gap-2 text-[13px] font-medium"><Icon name="lock" size={15} />caddy</span>
              <span class="font-mono text-[11px] opacity-60">desk.example.com :443</span>
            </div>
            <div class="grid w-full grid-cols-[1fr_56px_1fr]">
              <div class="flex flex-col items-center"><span class="h-5 w-px bg-fg/30"></span><span class="font-mono text-[10.5px] text-subtle">/*</span><span class="h-2 w-px bg-fg/30"></span></div>
              <div></div>
              <div class="flex flex-col items-center"><span class="h-5 w-px bg-fg/30"></span><span class="font-mono text-[10.5px] text-subtle">/socket</span><span class="h-2 w-px bg-fg/30"></span></div>
            </div>
            <div class="grid w-full grid-cols-[1fr_56px_1fr] items-center">
              <div class="rounded-[6px] border border-line bg-raised p-3.5 shadow-card">
                <div class="flex items-center gap-2 text-[13px] font-medium text-fg"><Icon name="cpu" size={15} />opendesk</div>
                <div class="mt-1.5 font-mono text-[10.5px] leading-relaxed text-subtle">api, workers, web app<br />embedded NATS</div>
              </div>
              <div class="flex flex-col items-center gap-1">
                <span class="font-mono text-[9.5px] text-subtle">events</span>
                <span class="relative h-px w-full bg-fg/30"><span class="absolute -right-px -top-[3px] size-[7px] rotate-45 border-r border-t border-fg/40"></span></span>
                <span class="font-mono text-[9.5px] text-subtle">NATS</span>
              </div>
              <div class="rounded-[6px] border border-line bg-raised p-3.5 shadow-card">
                <div class="flex items-center gap-2 text-[13px] font-medium text-fg"><Icon name="radio" size={15} />realtime</div>
                <div class="mt-1.5 font-mono text-[10.5px] leading-relaxed text-subtle">channels, presence<br />no database</div>
              </div>
            </div>
            <div class="grid w-full grid-cols-[1fr_56px_1fr]">
              <div class="flex flex-col items-center"><span class="h-6 w-px bg-fg/30"></span></div>
            </div>
            <div class="grid w-full grid-cols-[1fr_56px_1fr]">
              <div class="flex items-center gap-2 rounded-[6px] border border-line bg-raised p-3.5 text-[13px] font-medium text-fg shadow-card">
                <Icon name="database" size={15} />postgres
                <span class="ml-auto whitespace-nowrap font-mono text-[10.5px] font-normal text-subtle">data, jobs</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-px overflow-hidden rounded-[8px] border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s, i) => (
        <div class="reveal bg-bg p-6" style={`--d:${i * 50}ms`}>
          <div class="flex items-center gap-2"><Icon name={s.icon} size={16} class="text-fg" /><span class="font-mono text-[13px] text-fg">{s.name}</span></div>
          <p class="mt-3 text-[14px] leading-relaxed text-muted">{s.role}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Installer -->
  <section class="border-y border-line bg-surface-2">
    <div class="container-page grid gap-12 py-20 md:py-28 lg:grid-cols-2">
      <div class="reveal">
        <div class="label">The installer</div>
        <h2 class="h-section mt-4">Read it before you run it.</h2>
        <p class="lede mt-5 text-[17px] leading-[1.65]">The installer is a plain shell script that says what it will do before it does it. It asks for sudo only for the steps that need it, and running it again reconfigures in place without regenerating your secrets.</p>
        <div class="mt-8 overflow-hidden rounded-[8px] border border-line bg-raised">
          <div class="border-b border-line px-4 py-2.5 text-[12px] text-subtle">Verify first, if you would rather</div>
          <pre class="overflow-x-auto px-4 py-4 font-mono text-[12.5px] leading-[1.8] text-fg"><span class="text-subtle">$</span> curl -fsSLO https://opendesk.sh/install.sh
<span class="text-subtle">$</span> curl -fsSLO https://opendesk.sh/install.sh.sha256
<span class="text-subtle">$</span> sha256sum -c install.sh.sha256
<span class="text-subtle">$</span> less install.sh && sh install.sh</pre>
        </div>
        <p class="mt-4 text-[13.5px] text-muted">Flags for unattended installs: <code class="font-mono text-fg">--domain</code>, <code class="font-mono text-fg">--email</code>, <code class="font-mono text-fg">--wizard</code> for email, storage and inbound mail, and <code class="font-mono text-fg">--dry-run</code> to print the .env and change nothing. <code class="font-mono text-fg">--help</code> lists them all.</p>
      </div>
      <ol class="reveal relative space-y-0" style="--d:80ms">
        {installSteps.map(([t, d], i) => (
          <li class="relative flex gap-5 pb-8 last:pb-0">
            {i < installSteps.length - 1 && <span class="absolute left-[15px] top-9 bottom-0 w-px bg-line"></span>}
            <span class="relative flex size-8 shrink-0 items-center justify-center rounded-full border border-line bg-bg font-mono text-[12px] text-fg">{i + 1}</span>
            <div class="pt-1">
              <div class="text-[16px] font-medium text-fg">{t}</div>
              <p class="mt-1 text-[14.5px] leading-relaxed text-muted">{d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Day two -->
  <section class="container-page py-20 md:py-28">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal">
        <div class="label">Day two</div>
        <h2 class="h-section mt-4">Upgrades are a pull and a restart.</h2>
        <p class="lede mt-5 text-[17px] leading-[1.65]">Migrations are embedded in the binary and run at boot. <code class="font-mono text-[15px] text-fg">opendesk-ctl</code> sits next to your compose file for everything after install.</p>
        <p class="mt-5 rounded-[6px] border border-line bg-surface-2 p-4 text-[14px] leading-relaxed text-muted"><span class="font-medium text-fg">Keep a copy of .env.</span> CREDENTIALS_KEY encrypts stored mailbox credentials and cannot be recovered. A database backup without it cannot decrypt them.</p>
      </div>
      <div class="reveal overflow-hidden rounded-[8px] border border-line" style="--d:80ms">
        {ctl.map(([c, d]) => (
          <div class="flex flex-col gap-1 border-b border-line px-5 py-4 last:border-b-0 sm:flex-row sm:items-center sm:gap-6">
            <code class="shrink-0 font-mono text-[13px] text-fg sm:w-[290px] whitespace-nowrap"><span class="text-subtle">./opendesk-ctl</span> {c}</code>
            <span class="text-[14px] text-muted">{d}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Options -->
  <section class="container-page">
    <div class="reveal">
      <div class="label">Make it yours</div>
      <h2 class="h-section mt-4">Configured with environment variables.</h2>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {[
        ['mail', 'Inbound email', 'Forwarding addresses on your own inbound domain, received by the built-in SMTP receiver or a Cloudflare Email Worker. Or connect mailboxes over IMAP, Google or Microsoft.'],
        ['send', 'Outbound email', 'Replies go out through each customer-facing mailbox, so they come from your address. System mail like invites uses SMTP or Amazon SES.'],
        ['archive', 'Attachments', 'Local disk by default, or any S3-compatible store: AWS S3, Cloudflare R2 or MinIO.'],
        ['key', 'Sign-in', 'Passwords with two-factor, and optional Google, Microsoft, GitHub or any OIDC provider. Turn sign-ups off once your team is in.'],
        ['database', 'Postgres', 'Stock Postgres, the bundled container or your own managed instance. A pooled URL for requests and a direct one for migrations and jobs.'],
        ['layers', 'Scale out', 'Split the binary into api and worker roles, run more gateways, and point them at an external NATS cluster when one box is not enough.'],
      ].map(([icon, t, d], i) => (
        <div class="reveal card p-6" style={`--d:${(i % 3) * 50}ms`}>
          <Icon name={icon as 'mail'} size={18} class="text-fg" />
          <div class="mt-4 text-[16px] font-medium text-fg">{t}</div>
          <p class="mt-2 text-[14.5px] leading-relaxed text-muted">{d}</p>
        </div>
      ))}
    </div>
    <p class="reveal mt-8 text-[15px] text-muted">Every variable, with its default, is in the <a href={`${LINKS.docs}/self-hosting/configuration/`} class="text-fg underline decoration-line underline-offset-4 hover:decoration-fg">configuration reference</a>.</p>
  </section>

  <CTA title="Run it tonight." body="One command on a fresh server. If you would rather not run servers at all, the cloud is the same product." secondary={{ href: `${LINKS.docs}/self-hosting/`, label: 'Read the guide' }} />
</Layout>
