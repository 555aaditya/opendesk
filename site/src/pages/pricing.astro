---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import CopyCommand from '../components/CopyCommand.astro';
import CTA from '../components/CTA.astro';
import { PLANS, PRO_PRICE, ALL_FEATURES, CREDIT_COSTS, CREDIT_PACK } from '../lib/pricing';

const faq = [
  {
    q: 'Who counts as a user on Pro?',
    a: 'Owners, admins and agents: the people who can reply to customers. Viewers, who can read but not change anything, are free. Adding or removing a user is prorated.',
  },
  {
    q: 'Is the Free plan really free forever?',
    a: 'Yes, for any organization. It has every feature, with one mailbox, one team member and 50 AI credits a month. Upgrade when your team grows.',
  },
  {
    q: 'What happens if I downgrade?',
    a: 'Nothing is deleted. Your existing mailboxes and members stay; you just cannot add new ones until the workspace is within the Free limits.',
  },
  {
    q: 'How do AI credits work?',
    a: `Each AI action costs a few credits, listed above. Pro includes 1,000 credits per paid user each month, pooled across the workspace. When the allowance runs out you can buy packs of ${CREDIT_PACK.credits.toLocaleString('en-US')} credits, which never expire. A failed AI call costs nothing.`,
  },
  {
    q: 'Is my data used to train AI models?',
    a: 'No. Customer content is sent to the AI provider only to perform the feature you asked for, and it is not used to train models. Admins can turn AI off for the whole workspace.',
  },
  {
    q: 'Is self-hosted really free?',
    a: 'Yes. opendesk is Apache-2.0 licensed. Self-hosted has every feature, no limits and no license key. Bring your own AI key, or point it at a local model. You pay only for your own servers.',
  },
];
---
<Layout title="Pricing" description={`opendesk is free forever for one mailbox and one user, $${PRO_PRICE} per user per month for unlimited everything, and free and unlimited when you self-host. Every feature on every plan.`} jsonLd={{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }}>
  <PageHero label="Pricing" title="Free to start.<br/>One price to grow." lede="Every plan has every feature, AI included. Plans differ only in limits." />

  <section class="band py-16 md:py-24 !border-t-0">
    <div class="container-page">
      <div class="modules lg:grid-cols-3">
        {PLANS.map((p, i) => {
          const dark = p.featured;
          return (
            <div class={`snap relative flex flex-col p-7 md:p-9 ${dark ? '!bg-inverse text-inverse-fg' : ''}`} style={`--d:${i * 80}ms`}>
              <div class="flex items-center gap-2.5">
                <Icon name={p.id === 'free' ? 'user' : p.id === 'pro' ? 'users' : 'server'} size={16} />
                <span class="text-[15px] font-semibold tracking-[-0.01em]">{p.name}</span>
                {dark && <span class="ml-auto font-mono text-[10.5px] uppercase tracking-[0.06em] opacity-60">Most teams</span>}
              </div>
              <p class={`mt-3 text-[14.5px] leading-relaxed ${dark ? 'opacity-70' : 'text-muted'}`}>{p.blurb}</p>
              <div class="mt-10 flex items-baseline gap-2">
                <span class="text-[56px] font-semibold leading-none tracking-[-0.05em] tabular-nums">{p.price}</span>
                <span class={`text-[14px] ${dark ? 'opacity-60' : 'text-muted'}`}>{p.unit}</span>
              </div>
              <div class={`mt-2 font-mono text-[11px] uppercase tracking-[0.06em] ${dark ? 'opacity-50' : 'text-subtle'}`}>{p.note}</div>
              <a href={p.cta.href} class={`btn mt-8 w-full ${dark ? 'bg-inverse-fg text-inverse hover:opacity-90' : 'btn-ghost'}`}>{p.cta.label}{dark && <Icon name="arrowRight" size={15} />}</a>
              <ul class={`mt-8 space-y-3 border-t pt-6 text-[14.5px] ${dark ? 'border-inverse-fg/15' : 'border-line text-body'}`}>
                {p.limits.map((f) => <li class="flex gap-3"><Icon name="check" size={16} class="mt-0.5 shrink-0" />{f}</li>)}
              </ul>
            </div>
          );
        })}
      </div>
      <p class="mt-5 px-1 text-[14px] text-muted">Need SSO enforcement, an SLA or invoicing? <a href="/contact/" class="text-fg underline decoration-line-strong underline-offset-4 hover:decoration-fg">Contact us</a>.</p>

      <div class="snap mt-10 card p-7 md:p-9">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="h-card">Included on every plan</h2>
          <a href="/features/" class="link-arrow !text-[14px]">See all features<Icon name="arrowRight" size={13} /></a>
        </div>
        <ul class="mt-6 grid gap-x-8 gap-y-3 text-[14.5px] text-body sm:grid-cols-2 lg:grid-cols-4">
          {ALL_FEATURES.map((f) => <li class="flex gap-3"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-fg" />{f}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="ai-credits" class="container-page scroll-mt-24 pt-20 md:pt-28">
    <SectionHead index="01" label="AI credits" title="Pay for AI by what it does." lede="Each AI action costs a few credits. Free includes 50 a month per workspace; Pro includes 1,000 per paid user a month, pooled so the whole team draws from one balance. Failed calls cost nothing." />
    <div class="mt-12 md:mt-16 modules lg:grid-cols-[1fr_1.4fr]">
      <div class="flex flex-col p-6 md:p-9">
        <span class="t-violet tint-bg inline-flex size-9 items-center justify-center rounded-[6px]"><Icon name="sparkles" size={17} /></span>
        <div class="mt-6 flex items-baseline justify-between gap-4">
          <span class="text-[17px] font-semibold tracking-[-0.02em] text-fg">Credit pack</span>
          <span class="font-mono text-[13px] text-fg">{CREDIT_PACK.credits.toLocaleString('en-US')} credits</span>
        </div>
        <p class="mt-2 text-[14.5px] leading-relaxed text-muted">A one-time purchase on Free or Pro. Packs never expire and are spent after the monthly allowance.</p>
        {/* PLACEHOLDER: credit pack price not decided; shows "Price coming soon" until CREDIT_PACK.price is set. */}
        <div class="mt-4 text-[14.5px] font-medium text-fg">{CREDIT_PACK.price === null ? 'Price coming soon' : `$${CREDIT_PACK.price} per pack`}</div>
        <p class="mt-8 border-t border-line pt-6 text-[13.5px] leading-relaxed text-muted lg:mt-auto">Self-hosted has no credits: AI runs on your own key or a local model, without limits.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-[14.5px]">
          <thead>
            <tr class="border-b border-line">
              <th class="px-6 py-4 font-normal"><span class="label">Action</span></th>
              <th class="px-6 py-4 text-right font-normal"><span class="label">Credits</span></th>
            </tr>
          </thead>
          <tbody>
            {CREDIT_COSTS.map((c) => (
              <tr class="border-b border-line-soft">
                <td class="px-6 py-3.5 text-body">{c.feature}</td>
                <td class="px-6 py-3.5 text-right"><span class="pill t-violet !h-6 min-w-7 justify-center font-mono !text-[12px]">{c.credits}</span></td>
              </tr>
            ))}
            <tr><td class="px-6 py-3.5 text-muted">Semantic search</td><td class="px-6 py-3.5 text-right"><span class="pill t-green font-mono">free</span></td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="container-page pt-16">
    <div class="snap card flex flex-col gap-6 p-7 md:flex-row md:items-center md:p-8">
      <div class="md:max-w-sm">
        <div class="h-card">Try it on your own machine first</div>
        <p class="mt-1.5 text-[14.5px] text-muted">The installer sets up opendesk, the realtime gateway and Postgres with Docker.</p>
      </div>
      <CopyCommand class="md:ml-auto md:w-[460px]" />
    </div>
  </section>

  <section class="container-page pt-20 md:pt-28">
    <SectionHead index="02" label="Questions" title="Pricing, plainly." lede="Something else? Write to us from the contact page." />
    <Faq items={faq} class="mt-12 md:mt-16" />
  </section>

  <CTA />
</Layout>
