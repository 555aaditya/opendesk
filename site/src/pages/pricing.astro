---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CopyCommand from '../components/CopyCommand.astro';
import CTA from '../components/CTA.astro';
import { PLANS, PRO_PRICE, ALL_FEATURES, CREDIT_COSTS, CREDIT_PACK } from '../lib/pricing';

const faq = [
  {
    q: 'Who counts as a user on Pro?',
    a: 'Owners, admins and agents: the people who can reply to customers. Viewers, who can read but not change anything, are free. Adding or removing a user is prorated.',
  },
  {
    q: 'Is the Free plan really free forever?',
    a: 'Yes, for any organization. It has every feature, with one mailbox, one team member and 50 AI credits a month. Upgrade when your team grows.',
  },
  {
    q: 'What happens if I downgrade?',
    a: 'Nothing is deleted. Your existing mailboxes and members stay; you just cannot add new ones until the workspace is within the Free limits.',
  },
  {
    q: 'How do AI credits work?',
    a: `Each AI action costs a few credits, listed above. Pro includes 1,000 credits per paid user each month, pooled across the workspace. When the allowance runs out you can buy packs of ${CREDIT_PACK.credits.toLocaleString('en-US')} credits, which never expire. A failed AI call costs nothing.`,
  },
  {
    q: 'Is my data used to train AI models?',
    a: 'No. Customer content is sent to the AI provider only to perform the feature you asked for, and it is not used to train models. Admins can turn AI off for the whole workspace.',
  },
  {
    q: 'Is self-hosted really free?',
    a: 'Yes. opendesk is Apache-2.0 licensed. Self-hosted has every feature, no limits and no license key. Bring your own AI key, or point it at a local model. You pay only for your own servers.',
  },
];
---
<Layout title="Pricing" description={`opendesk is free forever for one mailbox and one user, $${PRO_PRICE} per user per month for unlimited everything, and free and unlimited when you self-host. Every feature on every plan.`}>
  <PageHero eyebrow="Pricing" title="Free to start.<br/>One price to grow." lede="Every plan has every feature, AI included. Plans differ only in limits." align="center" />

  <section class="container-page -mt-px pt-14 md:pt-20">
    <div class="grid gap-4 lg:grid-cols-3">
      {PLANS.map((p, i) => {
        const dark = p.featured;
        return (
          <div class={`reveal relative flex flex-col rounded-2xl p-7 md:p-8 ${dark ? 'order-first bg-inverse text-inverse-fg lg:order-none' : 'card'}`} style={`--d:${i * 60}ms`}>
            <div class="flex items-center gap-2">
              <Icon name={p.id === 'free' ? 'user' : p.id === 'pro' ? 'users' : 'server'} size={17} class={dark ? '' : 'text-fg'} />
              <span class={`text-[15px] font-medium ${dark ? '' : 'text-fg'}`}>{p.name}</span>
              {dark && <span class="ml-auto rounded-full bg-inverse-fg/10 px-2.5 py-1 text-[11.5px] opacity-80">Most teams</span>}
            </div>
            <p class={`mt-3 text-[14.5px] leading-relaxed ${dark ? 'opacity-70' : 'text-muted'}`}>{p.blurb}</p>
            <div class="mt-8 flex items-baseline gap-2">
              <span class={`text-[52px] font-semibold leading-none tracking-[-0.045em] ${dark ? '' : 'text-fg'}`}>{p.price}</span>
              <span class={`text-[14px] ${dark ? 'opacity-70' : 'text-muted'}`}>{p.unit}</span>
            </div>
            <div class={`mt-1 text-[13px] ${dark ? 'opacity-55' : 'text-subtle'}`}>{p.note}</div>
            <a href={p.cta.href} class={dark ? 'btn mt-8 w-full bg-inverse-fg text-inverse hover:opacity-90' : 'btn btn-ghost mt-8 w-full'}>{p.cta.label}{dark && <Icon name="arrowRight" size={15} />}</a>
            <ul class={`mt-8 space-y-3 border-t pt-6 text-[14.5px] ${dark ? 'border-inverse-fg/15 opacity-90' : 'border-line text-fg/85'}`}>
              {p.limits.map((f) => <li class="flex gap-3"><Icon name="check" size={16} class="mt-0.5 shrink-0" />{f}</li>)}
            </ul>
          </div>
        );
      })}
    </div>
    <p class="reveal mt-5 text-center text-[14px] text-muted">Need SSO enforcement, an SLA or invoicing? <a href="/contact/" class="text-fg underline decoration-line underline-offset-4 hover:decoration-fg">Contact us</a>.</p>

    <!-- Included everywhere -->
    <div class="reveal mt-10 rounded-2xl border border-line bg-surface-2 p-7 md:p-8">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-[18px] font-semibold tracking-[-0.01em] text-fg">Included on every plan</h2>
        <a href="/features/" class="text-[14px] text-muted hover:text-fg">See all features</a>
      </div>
      <ul class="mt-6 grid gap-x-8 gap-y-3 text-[14.5px] text-fg/85 sm:grid-cols-2 lg:grid-cols-4">
        {ALL_FEATURES.map((f) => <li class="flex gap-3"><Icon name="check" size={16} class="mt-0.5 shrink-0" />{f}</li>)}
      </ul>
    </div>
  </section>

  <!-- AI credits -->
  <section id="ai-credits" class="container-page mt-24 scroll-mt-24 md:mt-32">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal">
        <div class="eyebrow">AI credits</div>
        <h2 class="display mt-4 text-[34px] sm:text-[44px] text-fg">Pay for AI by what it does.</h2>
        <p class="lede mt-5 text-[16.5px] leading-[1.65]">Each AI action costs a few credits. Free includes 50 a month per workspace; Pro includes 1,000 per paid user a month, pooled so the whole team draws from one balance. Failed calls cost nothing.</p>
        <div class="mt-8 rounded-2xl border border-line p-5">
          <div class="flex items-baseline justify-between gap-4">
            <span class="text-[15.5px] font-medium text-fg">Credit pack</span>
            <span class="font-mono text-[13px] text-fg">{CREDIT_PACK.credits.toLocaleString('en-US')} credits</span>
          </div>
          <p class="mt-2 text-[14px] leading-relaxed text-muted">A one-time purchase on Free or Pro. Packs never expire and are spent after the monthly allowance.</p>
          {/* PLACEHOLDER: credit pack price not decided; shows "Price coming soon" until CREDIT_PACK.price is set. */}
          <div class="mt-3 text-[14px] text-fg">{CREDIT_PACK.price === null ? 'Price coming soon' : `$${CREDIT_PACK.price} per pack`}</div>
        </div>
        <p class="mt-4 text-[13.5px] text-subtle">Self-hosted has no credits: AI runs on your own key or a local model, without limits.</p>
      </div>
      <div class="reveal overflow-hidden rounded-2xl border border-line" style="--d:80ms">
        <table class="w-full text-left text-[14.5px]">
          <thead>
            <tr class="border-b border-line bg-surface-2 text-[12px] uppercase tracking-[0.06em] text-subtle">
              <th class="px-5 py-3 font-medium">Action</th>
              <th class="px-5 py-3 text-right font-medium">Credits</th>
            </tr>
          </thead>
          <tbody>
            {CREDIT_COSTS.map((c) => (
              <tr class="border-b border-line-soft last:border-0">
                <td class="px-5 py-3.5 text-fg/90">{c.feature}</td>
                <td class="px-5 py-3.5 text-right"><span class="inline-flex min-w-7 justify-center rounded-md bg-surface px-1.5 py-0.5 font-mono text-[12.5px] text-fg ring-1 ring-line">{c.credits}</span></td>
              </tr>
            ))}
            <tr class="bg-surface-2"><td class="px-5 py-3.5 text-muted">Semantic search</td><td class="px-5 py-3.5 text-right font-mono text-[12.5px] text-muted">free</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Self-host strip -->
  <section class="container-page mt-20">
    <div class="reveal flex flex-col gap-6 rounded-2xl border border-line p-7 md:flex-row md:items-center md:p-8">
      <div class="md:max-w-sm">
        <div class="text-[18px] font-semibold tracking-[-0.01em] text-fg">Try it on your own machine first</div>
        <p class="mt-1.5 text-[14.5px] text-muted">The installer sets up opendesk, the realtime gateway and Postgres with Docker.</p>
      </div>
      <CopyCommand class="md:ml-auto md:w-[460px]" />
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-page mt-24 md:mt-32">
    <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal">
        <div class="eyebrow">Questions</div>
        <h2 class="display mt-4 text-[34px] sm:text-[44px] text-fg">Pricing, plainly.</h2>
        <p class="lede mt-4 text-[16px]">Something else? <a href="/contact/" class="text-fg underline decoration-line underline-offset-4 hover:decoration-fg">Ask us</a>.</p>
      </div>
      <div class="reveal divide-y divide-line border-y border-line">
        {faq.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-[16px] font-medium text-fg [&::-webkit-details-marker]:hidden">
              {f.q}
              <Icon name="chevronDown" size={17} class="shrink-0 text-subtle transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-muted">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
