---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { EMAILS, LINKS } from '../lib/site';

// PLACEHOLDER: the 3 business day acknowledgement target in the disclosure box is
// a commitment the owner must confirm.
// Written as invariants the code holds (AGENTS.md, CASA Tier 1 / ASVS L1), never as gaps.
const groups = [
  {
    icon: 'key',
    title: 'Authentication',
    items: [
      'Passwords are hashed with Argon2id, 12 to 128 characters, and checked against a list of breached passwords.',
      'Sign-in, sign-up and password reset are rate limited per IP and per account, and protected by Turnstile.',
      'Sign-in answers the same, in the same time, for an unknown email and a wrong password.',
      'Two-factor with TOTP refuses a code that was already used. Recovery codes are hashed and single use.',
      'Sensitive owner actions, such as deleting a workspace or disabling two-factor, need a recent sign-in and two-factor.',
    ],
  },
  {
    icon: 'lock',
    title: 'Sessions and tokens',
    items: [
      'Access tokens live 15 minutes. Refresh tokens rotate on every use and are stored hashed.',
      'Every token carries a purpose and is accepted by exactly one consumer.',
      'Signing out, changing a password or removing a member ends sessions and closes open sockets.',
      'Cookies are HttpOnly, Secure and SameSite=Lax, scoped to the path that needs them.',
      'API keys are shown once, stored hashed, scoped and bound to one workspace.',
    ],
  },
  {
    icon: 'users',
    title: 'Access control',
    items: [
      'Every read and write of workspace data is scoped to the caller’s workspace on the server.',
      'Any referenced record, such as a contact, team or mailbox, is checked to belong to the same workspace.',
      'Roles are owner, admin, agent and viewer. Viewers read only, and settings need an admin.',
    ],
  },
  {
    icon: 'database',
    title: 'Data protection',
    items: [
      'Traffic is encrypted in transit with TLS. Data at rest is encrypted by our storage providers.',
      'Mailbox passwords, OAuth tokens, webhook secrets and two-factor secrets are also encrypted with AES-GCM by the application.',
      'Email and agent HTML is sanitized before it is stored.',
      'Webhooks and other outbound requests go to HTTPS addresses only, never to private or internal networks.',
      'Logs never contain secrets, tokens, passwords or request bodies.',
    ],
  },
  {
    icon: 'eye',
    title: 'Accountability',
    items: [
      'Security events are kept in an audit log: sign-ins and failures, two-factor and password changes, member and role changes, API keys, webhooks, and mailbox connections.',
      'Users can delete their account, and owners their workspace. Data is removed, not hidden.',
      'Dependencies and images are scanned for known vulnerabilities in CI.',
    ],
  },
] as const;
---
<Layout title="Security" description="How opendesk protects your data: Argon2id passwords, two-factor, scoped tokens, workspace isolation, encryption in transit and at rest, audit logs, CASA Tier 1 controls and responsible disclosure.">
  <PageHero eyebrow="Security" title="Security you can read." lede="opendesk handles your customers’ email, so security is a property of the code, not a page of promises. The code is open, and these are the rules every change follows." />

  <section class="container-page py-20 md:py-24">
    <div class="grid gap-4 md:grid-cols-3">
      {[
        ['shield', 'CASA Tier 1', 'opendesk connects to Gmail with restricted Google scopes, so its Google OAuth client is assessed under the App Defense Alliance Cloud Application Security Assessment, Tier 1 (OWASP ASVS 4.0.3 Level 1).'],
        ['lock', 'Encrypted in transit and at rest', 'TLS for every connection, encryption at rest by our providers, and application-level AES-GCM for every stored credential.'],
        ['code', 'Open to inspection', 'The code that runs the cloud is public. You, your security team or anyone else can audit it.'],
      ].map(([icon, t, d], i) => (
        <div class="reveal card p-7" style={`--d:${i * 50}ms`}>
          <span class="flex size-9 items-center justify-center rounded-lg bg-fg text-bg"><Icon name={icon as 'shield'} size={17} /></span>
          <h2 class="mt-6 text-[19px] font-semibold tracking-[-0.02em] text-fg">{t}</h2>
          <p class="mt-2.5 text-[14.5px] leading-relaxed text-muted">{d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-line">
    <div class="container-page py-20 md:py-24">
      <div class="reveal max-w-2xl">
        <div class="eyebrow">Controls</div>
        <h2 class="display mt-4 text-[34px] sm:text-[44px] text-fg">What the code guarantees.</h2>
      </div>
      <div class="mt-12 divide-y divide-line border-y border-line">
        {groups.map((g) => (
          <div class="reveal grid gap-6 py-10 lg:grid-cols-[280px_1fr]">
            <div class="flex items-center gap-3 self-start">
              <Icon name={g.icon} size={18} class="text-fg" />
              <h3 class="text-[17px] font-semibold text-fg">{g.title}</h3>
            </div>
            <ul class="grid gap-3.5 text-[15px] leading-relaxed text-muted">
              {g.items.map((it) => <li class="flex gap-3"><Icon name="check" size={16} class="mt-1 shrink-0 text-fg" />{it}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page">
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="reveal card p-7 md:p-8">
        <div class="eyebrow">Hosting</div>
        <h2 class="mt-4 text-[22px] font-semibold tracking-[-0.02em] text-fg">Where the cloud runs</h2>
        <p class="mt-3 text-[15px] leading-relaxed text-muted">The API and realtime gateway run on AWS. The web app, this site and inbound email routing run on Cloudflare. Data is stored in Postgres hosted by Neon. Product analytics use PostHog, without tracking cookies on this site. The full list is in the <a href="/privacy/#subprocessors" class="text-fg underline decoration-line underline-offset-4 hover:decoration-fg">privacy policy</a>.</p>
        <p class="mt-4 text-[15px] leading-relaxed text-muted">Self-hosted installs send nothing to us. You choose where they run and what they connect to.</p>
      </div>
      <div id="disclosure" class="reveal scroll-mt-24 rounded-2xl bg-inverse p-7 text-inverse-fg md:p-8" style="--d:60ms">
        <div class="font-mono text-[12px] uppercase tracking-[0.06em] opacity-55">Responsible disclosure</div>
        <h2 class="mt-4 text-[22px] font-semibold tracking-[-0.02em]">Found a vulnerability?</h2>
        <p class="mt-3 text-[15px] leading-relaxed opacity-75">Email <a href={`mailto:${EMAILS.security}`} class="underline underline-offset-4">{EMAILS.security}</a> with what you found, how to reproduce it and the impact you expect. Please do not open a public issue, and give us a reasonable time to fix it before you share it.</p>
        <ul class="mt-5 space-y-2.5 text-[14.5px] opacity-85">
          {[
            'We acknowledge reports within 3 business days.',
            'We keep you updated until it is fixed, and credit you if you want.',
            'We will not pursue research done in good faith: test only accounts you own, do not access other people’s data, and do not degrade the service.',
          ].map((t) => <li class="flex gap-3"><Icon name="check" size={16} class="mt-0.5 shrink-0" />{t}</li>)}
        </ul>
        <a href={`mailto:${EMAILS.security}`} class="btn mt-7 bg-inverse-fg text-inverse hover:opacity-90"><Icon name="mail" size={15} />{EMAILS.security}</a>
      </div>
    </div>
    <p class="reveal mt-8 text-[14.5px] text-muted">More detail for self-hosters is in the <a href={`${LINKS.docs}/security/`} class="text-fg underline decoration-line underline-offset-4 hover:decoration-fg">security docs</a>.</p>
  </section>
</Layout>
