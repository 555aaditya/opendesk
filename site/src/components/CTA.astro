---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { LINKS } from '../lib/site';

interface Props {
  title?: string;
  body?: string;
  secondary?: { href: string; label: string };
}
const {
  title = 'Give every customer a good answer.',
  body = 'Start on the cloud in a minute, or self-host it tonight. It is the same code either way.',
  secondary,
} = Astro.props;
---
<section class="container-page mt-28 md:mt-36">
  <div class="reveal relative overflow-hidden rounded-[28px] border border-line bg-surface-2 px-6 py-16 text-center sm:px-10 md:py-24">
    <div class="pointer-events-none absolute inset-0 bg-grid fade-mask opacity-70" aria-hidden="true"></div>
    <div class="relative">
      <Logo variant="mark" class="mx-auto size-12 text-fg" />
      <h2 class="display mx-auto mt-8 max-w-2xl text-[34px] sm:text-[48px] md:text-[56px] text-fg">{title}</h2>
      <p class="lede mx-auto mt-5 max-w-xl text-[17px] leading-[1.6]">{body}</p>
      <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href={LINKS.signup} class="btn btn-primary btn-lg w-full sm:w-auto">Start for free<Icon name="arrowRight" size={16} /></a>
        {secondary ? (
          <a href={secondary.href} class="btn btn-ghost btn-lg w-full sm:w-auto">{secondary.label}</a>
        ) : (
          <a href="/self-hosting/" class="btn btn-ghost btn-lg w-full sm:w-auto"><Icon name="terminal" size={16} />Self-host</a>
        )}
      </div>
    </div>
  </div>
</section>
