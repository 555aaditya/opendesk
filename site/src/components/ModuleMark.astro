---
/**
 * The Module mark drawn large, as the hero's illustration: three squares and the
 * circle, each one a part of opendesk. The pieces slide into the grid on load,
 * keep the brand's proportions (gap 4/26, corner 7/26), and nudge on hover.
 * `plain` draws the bare mark, e.g. inverted on the closing band.
 */
import Icon from './Icon.astro';

interface Props {
  plain?: boolean;
  class?: string;
}
const { plain = false, class: className = '' } = Astro.props;

const pieces = [
  { k: 'tl', icon: 'mail', title: 'Email', meta: 'support@northwind.io', n: '12 open', t: 't-blue' },
  { k: 'tr', icon: 'sparkles', title: 'AI', meta: 'Draft ready', n: '', t: 't-violet' },
  { k: 'bl', icon: 'chat', title: 'Live chat', meta: '13 languages', n: '3 live', t: 't-teal' },
  { k: 'br', icon: 'book', title: 'Help center', meta: 'help.northwind.io', n: '48 articles', t: 't-amber' },
] as const;
---
<div class={`mm ${plain ? 'mm-plain' : ''} ${className}`} aria-hidden="true">
  {pieces.map((p, i) => (
    <div class={`mm-piece mm-${p.k} ${plain ? 'snap' : ''}`} style={plain ? `--sx:${p.k.endsWith('l') ? -14 : 14}px;--sy:${p.k.startsWith('t') ? -14 : 14}px;--d:${[0, 260, 90, 170][i]}ms` : undefined}>
      {!plain && (p.k === 'tr' ? (
        <div class="flex h-full flex-col items-center justify-center text-center">
          <span class="t-violet inline-flex size-9 items-center justify-center rounded-full" style="background:color-mix(in oklab, var(--c-violet) 30%, transparent);color:#c4b5fd"><Icon name="sparkles" size={18} /></span>
          <div class="mt-2 text-[15px] font-semibold tracking-[-0.02em]">AI</div>
          <div class="mt-1 font-mono text-[10.5px] uppercase tracking-[0.06em] opacity-60">Draft ready</div>
        </div>
      ) : (
        <div class="flex h-full flex-col justify-between p-[9%]">
          <div class="flex items-center justify-between">
            <span class={`${p.t} tint-bg inline-flex size-9 items-center justify-center rounded-[7px]`}><Icon name={p.icon} size={17} /></span>
            {p.n && <span class="font-mono text-[10.5px] tabular-nums text-muted">{p.n}</span>}
          </div>
          <div>
            <div class="text-[15px] font-semibold tracking-[-0.02em] text-fg">{p.title}</div>
            <div class="mt-0.5 truncate font-mono text-[10.5px] text-subtle">{p.meta}</div>
          </div>
        </div>
      ))}
    </div>
  ))}
</div>

<style>
  .mm {
    --u: calc(100% / 56);
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }
  .mm-piece {
    position: absolute;
    width: calc(var(--u) * 26);
    height: calc(var(--u) * 26);
    border-radius: 22%;
    background: var(--raised);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    animation: mm-in 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1), border-color 200ms ease;
  }
  .mm-tl { left: 0; top: 0; --fx: -18px; --fy: -10px; animation-delay: 80ms; }
  .mm-bl { left: 0; top: calc(var(--u) * 30); --fx: -18px; --fy: 10px; animation-delay: 160ms; }
  .mm-br { left: calc(var(--u) * 30); top: calc(var(--u) * 30); --fx: 18px; --fy: 10px; animation-delay: 240ms; }
  .mm-tr {
    left: calc(var(--u) * 30); top: 0;
    border-radius: 999px;
    background: var(--inverse);
    border-color: var(--inverse);
    color: var(--inverse-fg);
    --fx: 26px; --fy: -26px;
    animation-name: mm-roll;
    animation-duration: 1100ms;
    animation-delay: 420ms;
  }
  .mm:hover .mm-tl { transform: translate(-4px, -4px); }
  .mm:hover .mm-bl { transform: translate(-4px, 4px); }
  .mm:hover .mm-br { transform: translate(4px, 4px); }
  .mm:hover .mm-tr { transform: translate(4px, -4px); }

  .mm-plain .mm-piece { background: currentColor; border-color: currentColor; box-shadow: none; border-radius: 27%; animation: none; }
  .mm-plain .mm-tr { border-radius: 999px; }
  .mm-plain .mm-tr { background: currentColor; }

  @keyframes mm-in { from { opacity: 0; transform: translate(var(--fx), var(--fy)); } }
  @keyframes mm-roll { from { opacity: 0; transform: translate(var(--fx), var(--fy)) rotate(-90deg) scale(0.6); } }
  @media (prefers-reduced-motion: reduce) {
    .mm-piece { animation: none; transition: none; }
  }
</style>
