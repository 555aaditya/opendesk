---
/**
 * The opendesk inbox at 1280 x 760: views and mailboxes, the queue, an open
 * ticket and the details rail. On a loop, a chat ticket arrives over the
 * socket, a teammate joins the ticket, and an AI draft streams into the reply.
 */
import Stage from '../Stage.astro';
import Icon from '../Icon.astro';
import Avatar from '../mock/Avatar.astro';

const views = [
  { icon: 'inbox', label: 'Unassigned', n: '4' },
  { icon: 'user', label: 'Mine', n: '7', active: true },
  { icon: 'users', label: 'Billing team', n: '11' },
  { icon: 'clock', label: 'Pending', n: '5' },
  { icon: 'alarm', label: 'Breaching soon', n: '2' },
] as const;

type Row = { who: string; initials: string; subject: string; preview: string; time: string; channel: 'mail' | 'chat'; status: 'Open' | 'Pending' | 'Solved'; tag?: [string, string]; sla?: string; slaTone?: 'warn' | 'bad'; unread?: boolean; selected?: boolean };
const statusTone = { Open: 't-blue', Pending: 't-amber', Solved: 't-green' } as const;
const rows: Row[] = [
  { who: 'Jonas Weber', initials: 'JW', subject: 'Can’t export invoices to CSV', preview: 'The export button spins and then…', time: '4m', channel: 'mail', status: 'Open', tag: ['billing', 't-teal'], sla: '12m', slaTone: 'warn', selected: true },
  { who: 'Ana Souza', initials: 'AS', subject: 'Change billing email', preview: 'Could you move invoices to finance@…', time: '18m', channel: 'mail', status: 'Open', tag: ['billing', 't-teal'], unread: true },
  { who: 'Kenji Mori', initials: 'KM', subject: 'SSO with Okta?', preview: 'We use Okta for everything, is OIDC…', time: '42m', channel: 'chat', status: 'Pending', tag: ['sso', 't-violet'] },
  { who: 'Sara Lindqvist', initials: 'SL', subject: 'Refund for a duplicate charge', preview: 'I was charged twice on the 3rd.', time: '1h', channel: 'mail', status: 'Open', tag: ['refund', 't-pink'], sla: 'Breached', slaTone: 'bad' },
  { who: 'Diego Alvarez', initials: 'DA', subject: 'API rate limits for bulk import', preview: 'What is the limit per minute for…', time: '2h', channel: 'mail', status: 'Pending', tag: ['api', 't-blue'] },
  { who: 'Mei Chen', initials: 'MC', subject: 'Thanks, all working now', preview: 'That fixed it, appreciate the help!', time: '3h', channel: 'chat', status: 'Solved' },
  { who: 'Tom Becker', initials: 'TB', subject: 'Invoice address for Germany', preview: 'Our VAT id changed last month…', time: '4h', channel: 'mail', status: 'Open', tag: ['billing', 't-teal'] },
];
---
<Stage w={1280} h={700} mobileW={454} mobileX={546} tone="plain" label="The opendesk inbox: a queue of tickets from email and chat, an open ticket with an AI drafted reply, and the customer's details.">
  <div class="app-window left-0 top-0 w-[1280px] h-[700px] !rounded-none !border-0 flex text-left" data-seq data-hold="4200">
    <!-- Sidebar -->
    <aside class="w-[216px] shrink-0 flex flex-col border-r border-line bg-surface-2 px-3 py-3.5">
      <div class="flex items-center gap-2 px-2 pb-3.5">
        <span class="flex size-6 items-center justify-center rounded-[5px] bg-fg text-bg text-[11px] font-semibold">N</span>
        <span class="text-[13px] font-semibold text-fg">Northwind</span>
        <Icon name="chevronDown" size={13} class="ml-auto text-subtle" />
      </div>
      <div class="mb-4 flex h-8 items-center gap-2 rounded-[5px] bg-bg px-2.5 text-[12px] text-subtle ring-1 ring-line">
        <Icon name="search" size={13} />Search<span class="ml-auto kbd">⌘K</span>
      </div>
      <div class="px-2 pb-1.5 font-mono text-[10px] uppercase tracking-[0.08em] text-subtle">Views</div>
      {views.map((v) => (
        <div class={`flex h-8 items-center gap-2.5 rounded-[5px] px-2 text-[12.5px] ${'active' in v ? 'bg-bg text-fg font-medium ring-1 ring-line' : 'text-muted'}`}>
          <Icon name={v.icon} size={14} />{v.label}
          <span class={`ml-auto font-mono text-[11px] tabular-nums ${'active' in v ? 'text-fg' : 'text-subtle'}`}>{v.n}</span>
        </div>
      ))}
      <div class="px-2 pb-1.5 pt-5 font-mono text-[10px] uppercase tracking-[0.08em] text-subtle">Channels</div>
      {['support@northwind.io', 'billing@northwind.io'].map((m) => (
        <div class="flex h-8 items-center gap-2.5 rounded-[5px] px-2 text-[12.5px] text-muted"><Icon name="mail" size={14} /><span class="truncate">{m}</span></div>
      ))}
      <div class="flex h-8 items-center gap-2.5 rounded-[5px] px-2 text-[12.5px] text-muted"><Icon name="chat" size={14} />Live chat<span class="ml-auto size-1.5 rounded-full bg-ok od-live"></span></div>
      <div class="flex h-8 items-center gap-2.5 rounded-[5px] px-2 text-[12.5px] text-muted"><Icon name="book" size={14} />Help center</div>
      <div class="mt-auto flex items-center gap-2.5 border-t border-line px-2 pt-3">
        <Avatar initials="LH" size={24} tone={1} />
        <div class="min-w-0">
          <div class="text-[12px] font-medium leading-4 text-fg">Lena Hart</div>
          <div class="text-[10.5px] leading-4 text-subtle">Agent · online</div>
        </div>
        <Icon name="bell" size={14} class="ml-auto text-subtle" />
      </div>
    </aside>

    <!-- Queue -->
    <section class="w-[330px] shrink-0 flex flex-col border-r border-line">
      <div class="flex h-[52px] items-center gap-2 border-b border-line px-4">
        <span class="text-[14px] font-semibold tracking-[-0.01em] text-fg">Mine</span>
        <span class="font-mono text-[11px] tabular-nums text-subtle">7</span>
        <span class="ml-auto inline-flex h-7 items-center gap-1.5 rounded-[5px] px-2 text-[11.5px] text-muted ring-1 ring-line"><Icon name="filter" size={12} />Due first</span>
      </div>
      <div class="flex-1 overflow-hidden">
        <!-- Arrives over the socket -->
        <div class="s-arrive overflow-hidden" style="height:78px" data-step="1" data-wait="1400">
          <div class="relative flex h-[78px] gap-3 border-b border-line px-4 py-3 bg-surface-2">
            <Avatar initials="PR" size={28} tone={2} />
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5">
                <span class="truncate text-[12.5px] font-semibold text-fg">Priya Raman</span>
                <Icon name="chat" size={11} class="shrink-0 text-subtle" />
                <span class="ml-auto shrink-0 font-mono text-[10.5px] text-fg">now</span>
              </div>
              <div class="mt-0.5 truncate text-[12.5px] text-fg">Widget not loading on checkout</div>
              <div class="mt-1 flex items-center gap-2">
                <span class="truncate text-[11.5px] text-subtle">Since this morning the chat bubble…</span>
                <span class="pill pill-dot t-blue ml-auto shrink-0">New</span>
              </div>
            </div>
          </div>
        </div>
        {rows.map((r, i) => (
          <div class={`relative flex h-[78px] gap-3 border-b border-line-soft px-4 py-3 ${r.selected ? 'bg-surface' : ''}`}>
            {r.selected && <span class="absolute inset-y-0 left-0 w-[2px] bg-fg"></span>}
            <Avatar initials={r.initials} size={28} tone={i % 4} />
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5">
                <span class={`truncate text-[12.5px] ${r.unread ? 'font-semibold text-fg' : 'font-medium text-fg/85'}`}>{r.who}</span>
                <Icon name={r.channel} size={11} class="shrink-0 text-subtle" />
                <span class="ml-auto shrink-0 font-mono text-[10.5px] tabular-nums text-subtle">{r.time}</span>
              </div>
              <div class={`mt-0.5 truncate text-[12.5px] ${r.unread ? 'text-fg' : 'text-muted'}`}>{r.subject}</div>
              <div class="mt-1 flex items-center gap-2">
                <span class="truncate text-[11.5px] text-subtle">{r.preview}</span>
                <span class="ml-auto flex shrink-0 items-center gap-1">
                  {r.tag && <span class={`pill ${r.tag[1]}`}>{r.tag[0]}</span>}
                  {r.sla ? (
                    <span class={`pill pill-dot font-mono ${r.slaTone === 'bad' ? 't-red' : 't-amber'}`}>{r.sla}</span>
                  ) : (
                    <span class={`pill pill-dot ${statusTone[r.status]}`}>{r.status}</span>
                  )}
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Open ticket -->
    <section class="flex min-w-0 flex-1 flex-col">
      <div class="flex h-[52px] items-center gap-3 border-b border-line px-5">
        <span class="font-mono text-[11.5px] text-subtle">#1042</span>
        <span class="truncate text-[14px] font-semibold tracking-[-0.01em] text-fg">Can’t export invoices to CSV</span>
        <div class="ml-auto flex items-center gap-2">
          <span class="s-pop inline-flex items-center gap-1.5 rounded-full py-0.5 pl-0.5 pr-2 text-[11px] text-muted ring-1 ring-line" data-step="2" data-wait="1300">
            <Avatar initials="MO" size={18} tone={3} />viewing
          </span>
          <span class="pill pill-dot t-orange !h-6 !text-[11px]">High</span>
          <span class="pill pill-dot t-blue !h-6 !text-[11px]">Open</span>
        </div>
      </div>

      <div class="flex-1 space-y-5 overflow-hidden px-5 py-5">
        <article class="flex gap-3">
          <Avatar initials="JW" size={28} tone={0} />
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline gap-2">
              <span class="text-[12.5px] font-semibold text-fg">Jonas Weber</span>
              <span class="truncate text-[11px] text-subtle">to support@northwind.io</span>
              <span class="ml-auto shrink-0 font-mono text-[10.5px] text-subtle">09:41</span>
            </div>
            <p class="mt-1.5 text-[13px] leading-[1.6] text-fg/90">Hi, the export button on the invoices page spins and then nothing downloads. I need the CSV for our month-end close today. Is something broken?</p>
            <div class="mt-2.5 inline-flex items-center gap-1.5 rounded-[5px] px-2 py-1 text-[11px] text-muted ring-1 ring-line"><Icon name="paperclip" size={11} />export-error.png<span class="text-subtle">84 KB</span></div>
          </div>
        </article>

        <div class="flex items-center gap-2 pl-10 font-mono text-[10.5px] text-subtle">
          <Icon name="zap" size={11} />rule <span class="text-muted">Billing to finance</span> set priority high · tagged billing
        </div>

        <article class="flex gap-3">
          <Avatar initials="MO" size={28} tone={3} />
          <div class="min-w-0 flex-1 rounded-[6px] border border-dashed border-line-strong px-3.5 py-2.5">
            <div class="flex items-baseline gap-2">
              <span class="text-[12.5px] font-semibold text-fg">Marco Oliveira</span>
              <span class="font-mono text-[9.5px] uppercase tracking-[0.08em] text-subtle">Internal note</span>
              <span class="ml-auto font-mono text-[10.5px] text-subtle">09:46</span>
            </div>
            <p class="mt-1 text-[12.5px] leading-[1.6] text-muted"><span class="text-fg">@Lena</span> exports over 5k rows time out. The fix ships today; can you send him the workaround?</p>
          </div>
        </article>

        <div class="s-up flex items-center gap-2 pl-10 text-[11.5px] text-subtle" data-step="2">
          <span class="inline-flex gap-[3px] text-subtle"><i class="od-dot"></i><i class="od-dot"></i><i class="od-dot"></i></span>
          Marco is viewing · you are replying
        </div>
      </div>

      <!-- Composer with an AI draft -->
      <div class="mx-5 mb-5 rounded-[8px] border border-line-strong bg-bg">
        <div class="flex h-10 items-center gap-4 border-b border-line px-3.5 text-[12px]">
          <span class="relative font-medium text-fg">Reply<span class="absolute -bottom-[13px] left-0 right-0 h-[1.5px] bg-fg"></span></span>
          <span class="text-subtle">Note</span>
          <span class="s-fade pill t-violet ml-auto !h-[22px] !px-2 !text-[11px]" data-step="3" data-wait="900"><Icon name="sparkles" size={11} />Draft · your voice</span>
        </div>
        <div class="min-h-[86px] px-3.5 pt-3 pb-1 text-[13px] leading-[1.6] text-fg">
          <p class="s-fade" data-step="3" data-stream="34">Hi Jonas, sorry about that. Exports over 5,000 rows time out right now and the fix ships today. Until then, filter the list by month and export each month on its own.</p>
        </div>
        <div class="flex items-center gap-1.5 px-2.5 pb-2.5">
          <span class="inline-flex size-7 items-center justify-center rounded-[5px] text-subtle"><Icon name="paperclip" size={14} /></span>
          <span class="inline-flex h-7 items-center gap-1.5 rounded-[5px] px-1.5 text-[11.5px] text-subtle"><span class="kbd">/</span>Saved replies</span>
          <span class="inline-flex h-7 items-center gap-1.5 rounded-[5px] px-1.5 text-[11.5px] text-subtle"><Icon name="globe" size={12} />English</span>
          <span class="ml-auto inline-flex h-8 items-center gap-2 rounded-[5px] bg-fg px-3 text-[12px] font-medium text-bg">Send<span class="font-mono text-[10px] opacity-60">⌘↵</span></span>
        </div>
      </div>
    </section>

    <!-- Details rail -->
    <aside class="w-[280px] shrink-0 flex flex-col gap-5 border-l border-line bg-surface-2 px-5 py-5 text-[12px]">
      <div>
        <div class="flex items-center gap-3">
          <Avatar initials="JW" size={34} tone={0} />
          <div class="min-w-0">
            <div class="text-[13.5px] font-semibold text-fg">Jonas Weber</div>
            <div class="truncate text-[11.5px] text-subtle">jonas@weber.dev</div>
          </div>
        </div>
        <div class="mt-3 flex items-center gap-1.5 text-[11.5px] text-muted"><Icon name="layers" size={12} />Weber Logistik · 6 tickets</div>
      </div>

      <div class="rounded-[6px] border border-line bg-bg p-3.5">
        <div class="t-violet flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.08em] tint"><Icon name="sparkles" size={11} />Summary</div>
        <ul class="mt-2 space-y-1.5 text-[12px] leading-[1.5] text-fg/85">
          <li class="flex gap-2"><span class="mt-[7px] size-1 shrink-0 rounded-full bg-fg"></span>CSV export spins, no download</li>
          <li class="flex gap-2"><span class="mt-[7px] size-1 shrink-0 rounded-full bg-fg"></span>Needs it for month-end close today</li>
        </ul>
        <div class="mt-2.5 flex gap-1.5"><span class="pill pill-dot t-amber">Frustrated</span><span class="pill t-grey">English</span></div>
      </div>

      <dl class="space-y-3">
        {[['Status', <span class="pill pill-dot t-blue">Open</span>], ['Priority', <span class="pill pill-dot t-orange">High</span>], ['Assignee', 'Lena Hart'], ['Team', <span class="pill t-teal">Billing</span>]].map(([k, v]) => (
          <div class="flex items-center justify-between gap-2">
            <dt class="text-subtle">{k}</dt>
            <dd class="font-medium text-fg">{v}</dd>
          </div>
        ))}
      </dl>

      <div class="rounded-[6px] border border-line bg-bg p-3.5">
        <div class="flex items-center justify-between">
          <span class="text-subtle">First reply</span>
          <span class="font-mono text-[11px] text-warn">12m left</span>
        </div>
        <div class="mt-2 h-1 overflow-hidden rounded-full bg-surface"><div class="h-full w-[78%] rounded-full bg-warn"></div></div>
        <div class="mt-3 flex items-center justify-between">
          <span class="text-subtle">Resolution</span>
          <span class="font-mono text-[11px] text-muted">7h 12m</span>
        </div>
        <div class="mt-2 h-1 overflow-hidden rounded-full bg-surface"><div class="h-full w-[22%] rounded-full fill-t t-blue"></div></div>
      </div>
    </aside>

    <!-- Realtime: the event that just landed -->
    <div class="s-pop absolute bottom-[68px] left-[12px] flex w-[192px] items-center gap-2 rounded-[6px] border border-line bg-raised px-2.5 py-2 shadow-[var(--shadow-float)]" data-step="1">
      <span class="size-2 shrink-0 rounded-full bg-ok od-live"></span>
      <span class="min-w-0 text-[11.5px] leading-4 text-fg"><span class="font-medium">New chat</span><br /><span class="font-mono text-[10px] text-subtle">ticket.created</span></span>
    </div>
  </div>
</Stage>
