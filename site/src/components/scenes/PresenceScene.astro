---
/** Presence on a ticket: who is viewing, who is replying, and the notifications that follow. */
import Stage from '../Stage.astro';
import Icon from '../Icon.astro';
import Avatar from '../mock/Avatar.astro';
const people = [
  ['LH', 'Lena Hart', 'replying', 1, 't-green'],
  ['MO', 'Marco Oliveira', 'viewing', 3, 't-blue'],
  ['KS', 'Kim Sato', 'viewing', 2, 't-blue'],
] as const;
---
<Stage w={560} h={400} label="Presence on an opendesk ticket: three teammates, one replying, with live notifications.">
  <div class="app-window left-[28px] top-[28px] w-[330px] h-[400px]" data-seq data-hold="3600">
    <div class="flex items-center gap-2 border-b border-line px-4 py-3">
      <span class="font-mono text-[11px] text-subtle">#1042</span>
      <span class="truncate text-[12.5px] font-semibold text-fg">Can’t export invoices</span>
    </div>
    <div class="space-y-2 p-4">
      <div class="font-mono text-[10px] uppercase tracking-[0.08em] text-subtle">On this ticket</div>
      {people.map(([i, n, st, tone, t], k) => (
        <div class="s-left flex items-center gap-2.5 rounded-[6px] px-2.5 py-2 ring-1 ring-line" data-step={k + 1} data-wait={k ? 600 : 700}>
          <span class="relative"><Avatar initials={i} size={26} tone={tone} /><span class={`${t} fill-t absolute -bottom-0.5 -right-0.5 size-2.5 rounded-full ring-2 ring-raised`}></span></span>
          <span class="text-[12px] font-medium text-fg">{n}</span>
          <span class={`pill ${t} ml-auto`}>{st}</span>
        </div>
      ))}
      <div class="s-up flex items-center gap-2 pt-2 text-[11.5px] text-subtle" data-step="4" data-wait="500"><span class="inline-flex gap-[3px]"><i class="od-dot"></i><i class="od-dot"></i><i class="od-dot"></i></span>Lena is typing a reply</div>
    </div>
  </div>
  <div class="float-card left-[310px] top-[150px] w-[222px]" data-seq data-hold="3600">
    <div class="flex items-center gap-2 border-b border-line px-3.5 py-2.5 text-[12px] font-semibold text-fg"><Icon name="bell" size={13} />Notifications</div>
    {[
      ['at', 'Marco mentioned you', '#1042 · now', 't-violet'],
      ['user', 'Assigned to you', '#1043 · 1m', 't-blue'],
      ['alarm', 'SLA breach in 10m', '#1037 · 2m', 't-red'],
    ].map(([icon, t, m, c], k) => (
      <div class="s-up flex items-start gap-2.5 border-b border-line-soft px-3.5 py-2.5 last:border-0" data-step={k + 1} data-wait={k ? 700 : 1400}>
        <span class={`${c} tint-bg inline-flex size-6 shrink-0 items-center justify-center rounded-[5px]`}><Icon name={icon as 'at'} size={12} /></span>
        <div><div class="text-[11.5px] font-medium text-fg">{t}</div><div class="font-mono text-[10px] text-subtle">{m}</div></div>
      </div>
    ))}
  </div>
</Stage>
