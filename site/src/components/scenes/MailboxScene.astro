---
/** Every address the team answers, connected four ways, and a reply leaving from the customer's own thread. */
import Stage from '../Stage.astro';
import Icon from '../Icon.astro';
const boxes = [
  ['support@northwind.io', 'acme-x7k2@in.opendesk.sh', 'Forwarding', 't-blue'],
  ['billing@northwind.io', 'Connected with OAuth', 'Google', 't-green'],
  ['sales@northwind.io', 'Connected with OAuth', 'Microsoft 365', 't-teal'],
  ['ops@northwind.io', 'mail.northwind.io:993', 'IMAP and SMTP', 't-amber'],
];
---
<Stage w={560} h={400} label="Four mailboxes connected to opendesk by forwarding, Google, Microsoft 365 and IMAP.">
  <div class="app-window left-[28px] top-[28px] w-[400px] h-[400px]" data-seq data-hold="3800">
    <div class="flex items-center gap-2 border-b border-line px-4 py-3">
      <span class="text-[12.5px] font-semibold text-fg">Mailboxes</span>
      <span class="ml-auto inline-flex h-7 items-center gap-1.5 rounded-[5px] bg-fg px-2.5 text-[11px] font-medium text-bg"><Icon name="plus" size={12} />Connect</span>
    </div>
    <div class="space-y-2 p-3">
      {boxes.map(([a, d, k, t], i) => (
        <div class="s-up flex items-center gap-3 rounded-[6px] px-3 py-2.5 ring-1 ring-line" data-step={i + 1} data-wait={i ? 450 : 600}>
          <span class={`${t} tint-bg inline-flex size-8 shrink-0 items-center justify-center rounded-[6px]`}><Icon name="mail" size={15} /></span>
          <div class="min-w-0">
            <div class="truncate text-[12.5px] font-medium text-fg">{a}</div>
            <div class="truncate font-mono text-[10px] text-subtle">{d}</div>
          </div>
          <span class={`pill pill-dot ${t} ml-auto`}>{k}</span>
        </div>
      ))}
    </div>
  </div>
  <div class="float-card s-pop left-[300px] top-[290px] w-[232px] p-3.5" data-seq data-hold="3800">
    <div class="flex items-center gap-2 text-[11.5px] font-medium text-fg"><Icon name="send" size={12} />Reply sent</div>
    <div class="mt-1 text-[11px] text-muted">From support@northwind.io, in the customer’s thread</div>
    <div class="mt-2.5 flex gap-1.5"><span class="pill pill-dot t-green" data-step="1" data-wait="2600">Delivered</span><span class="pill t-grey font-mono">250 OK</span></div>
  </div>
</Stage>
