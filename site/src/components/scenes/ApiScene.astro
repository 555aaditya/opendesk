---
/** Requests against the public API and the webhooks they fire, as they happen. */
import Stage from '../Stage.astro';
const log = [
  ['POST', '/v1/tickets', '201', '38ms'],
  ['PATCH', '/v1/tickets/tk_1042', '200', '21ms'],
  ['GET', '/v1/events?since=1041', '200', '12ms'],
  ['POST', '/v1/realtime/token', '200', '9ms'],
];
---
<Stage w={560} h={400} tone="ink" label="A log of opendesk API requests and signed webhook deliveries.">
  <div class="absolute left-[28px] top-[28px] w-[504px] h-[400px] overflow-hidden rounded-[8px] border border-white/12 bg-[#111] font-mono text-[11.5px] text-white/80" data-seq data-hold="3400">
    <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3 text-[10.5px] uppercase tracking-[0.08em] text-white/45">api.opendesk.sh<span class="ml-auto inline-flex items-center gap-1.5 normal-case tracking-normal"><span class="size-1.5 rounded-full bg-[#22c55e] od-live"></span>live</span></div>
    <div class="space-y-0 px-4 py-2">
      {log.map(([m, p, s, t], i) => (
        <div class="s-left flex items-center gap-3 border-b border-white/[0.06] py-2.5" data-step={i + 1} data-wait={i ? 650 : 600}>
          <span class="w-12 text-white">{m}</span><span class="truncate text-white/60">{p}</span>
          <span class="ml-auto inline-flex items-center gap-1.5 text-white/70"><span class="size-1.5 rounded-full bg-[#22c55e]"></span>{s}</span><span class="w-10 text-right text-white/35">{t}</span>
        </div>
      ))}
      <div class="s-up mt-3 rounded-[5px] border border-white/10 p-3" data-step="5" data-wait="700">
        <div class="flex items-center gap-2 text-white"><span class="text-white/40">webhook</span>ticket.updated<span class="ml-auto text-white/40">delivered · 84ms</span></div>
        <div class="mt-1.5 truncate text-white/35">OD-Signature: t=1760173200,v1=9c1e5f…</div>
      </div>
    </div>
  </div>
</Stage>
