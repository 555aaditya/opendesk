---
/** The public help center: a customer searches, the answers appear, ranked by meaning. */
import Stage from '../Stage.astro';
import Icon from '../Icon.astro';
const results = [
  ['Export invoices as CSV', 'Billing', '2 min read'],
  ['Download a monthly statement', 'Billing', '1 min read'],
  ['Large exports and time limits', 'Data', '3 min read'],
];
---
<Stage w={560} h={400} label="The opendesk help center, searching for how to export invoices.">
  <div class="app-window left-[28px] top-[28px] w-[504px] h-[400px]" data-seq data-hold="4000">
    <div class="flex items-center gap-2 border-b border-line px-5 py-3">
      <span class="flex size-5 items-center justify-center rounded-[6px] bg-fg text-[9px] font-semibold text-bg">N</span>
      <span class="text-[12.5px] font-semibold text-fg">Northwind help</span>
      <span class="ml-auto font-mono text-[10px] text-subtle">help.northwind.io</span>
    </div>
    <div class="px-6 pt-6">
      <div class="text-[19px] font-semibold tracking-[-0.03em] text-fg">How can we help?</div>
      <div class="mt-3 flex h-10 items-center gap-2.5 rounded-[6px] px-3 text-[13px] text-fg ring-1 ring-line-strong">
        <Icon name="search" size={14} class="text-subtle" />
        <span class="s-fade" data-step="1" data-wait="800" data-stream="70">how do I get my invoices out</span><span class="od-caret"></span>
      </div>
      <div class="mt-4 space-y-2">
        {results.map(([t, c, r], i) => (
          <div class="s-up flex items-center gap-3 rounded-[6px] border border-line px-3.5 py-3" data-step={i === 0 ? 2 : 2} data-wait="500" style={`transition-delay:${i * 90}ms`}>
            <span class={`${["t-teal","t-amber","t-blue"][i]} tint-bg inline-flex size-7 shrink-0 items-center justify-center rounded-[5px]`}><Icon name="fileText" size={14} /></span>
            <div class="min-w-0">
              <div class="truncate text-[12.5px] font-medium text-fg">{t}</div>
              <div class="font-mono text-[10px] text-subtle">{c} · {r}</div>
            </div>
            {i === 0 && <span class="pill t-violet ml-auto"><Icon name="sparkles" size={10} />Best match</span>}
          </div>
        ))}
      </div>
      <div class="s-fade t-violet tint mt-3 flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.06em]" data-step="2"><Icon name="sparkles" size={10} />Semantic search · 48 articles</div>
    </div>
  </div>
</Stage>
