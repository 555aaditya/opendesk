---
/** The chat widget on a customer's site: a visitor asks, an agent types and answers, in two languages. */
import Stage from '../Stage.astro';
import Icon from '../Icon.astro';
import Avatar from '../mock/Avatar.astro';
---
<Stage w={560} h={400} label="The opendesk chat widget on a website, with a visitor and an agent talking.">
  <!-- The customer's site, sketched in hairlines -->
  <div class="absolute left-[28px] top-[28px] w-[300px] h-[344px] rounded-[8px] border border-line bg-bg p-5">
    <div class="flex items-center gap-2"><span class="size-4 rounded-[5px] bg-line-strong"></span><span class="h-2 w-16 rounded-full bg-line"></span><span class="ml-auto h-2 w-10 rounded-full bg-line"></span></div>
    <div class="mt-8 h-3 w-44 rounded-full bg-line-strong"></div>
    <div class="mt-2.5 h-3 w-32 rounded-full bg-line-strong"></div>
    <div class="mt-5 space-y-2"><div class="h-2 w-full rounded-full bg-line"></div><div class="h-2 w-[86%] rounded-full bg-line"></div><div class="h-2 w-[70%] rounded-full bg-line"></div></div>
    <div class="mt-6 grid grid-cols-2 gap-2.5"><div class="h-[92px] rounded-[5px] border border-line"></div><div class="h-[92px] rounded-[5px] border border-line"></div></div>
  </div>

  <div class="float-card left-[196px] top-[24px] w-[300px] h-[300px] flex flex-col" data-seq data-hold="3800">
    <div class="flex items-center gap-2.5 border-b border-line px-4 py-3">
      <div class="flex -space-x-1.5"><Avatar initials="LH" size={22} tone={1} /><Avatar initials="MO" size={22} tone={3} /></div>
      <div class="min-w-0">
        <div class="text-[12.5px] font-semibold text-fg">Northwind</div>
        <div class="flex items-center gap-1 text-[10.5px] text-subtle"><span class="size-1.5 rounded-full bg-ok"></span>Replies in minutes</div>
      </div>
      <span class="pill t-grey ml-auto font-mono">DE</span>
    </div>
    <div class="flex-1 space-y-2.5 overflow-hidden px-3.5 py-3.5 text-[12px] leading-[1.45]">
      <div class="s-up ml-auto w-fit max-w-[80%] rounded-[8px] rounded-br-[3px] fill-t t-blue px-3 py-2 text-white" data-step="1" data-wait="700">Wie füge ich einen zweiten Admin hinzu?</div>
      <div class="s-fade t-violet flex items-center gap-1.5 font-mono text-[9.5px] uppercase tracking-[0.06em] tint" data-step="1"><Icon name="globe" size={10} />Translated for the agent</div>
      <div class="s-up flex w-fit items-center gap-1 rounded-[8px] bg-surface px-3 py-2.5 text-subtle" data-step="2" data-until="3" data-wait="900"><i class="od-dot"></i><i class="od-dot"></i><i class="od-dot"></i></div>
      <div class="s-up w-fit max-w-[84%] rounded-[8px] rounded-bl-[3px] bg-surface px-3 py-2 text-fg" data-step="3" data-wait="1600">Unter Einstellungen → Mitglieder auf „Einladen“ klicken und die Rolle Admin wählen.</div>
      <div class="s-up ml-auto w-fit rounded-[8px] rounded-br-[3px] fill-t t-blue px-3 py-2 text-white" data-step="4" data-wait="1500">Perfekt, danke!</div>
    </div>
    <div class="m-3 mt-0 flex h-9 items-center gap-2 rounded-[6px] px-3 text-[11.5px] text-subtle ring-1 ring-line">Nachricht schreiben…<Icon name="send" size={13} class="ml-auto" /></div>
  </div>

  <!-- The launcher: the one circle -->
  <div class="absolute left-[452px] top-[336px] t-blue fill-t flex size-11 items-center justify-center rounded-full text-white"><Icon name="chat" size={18} /></div>
</Stage>

