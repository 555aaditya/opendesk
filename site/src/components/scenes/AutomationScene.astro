---
/** A rule that runs on arrival, and the SLA clock it starts. */
import Stage from '../Stage.astro';
import Icon from '../Icon.astro';
const actions = [
  ['zap', 'Set priority', 'High', 't-orange'],
  ['users', 'Assign to team', 'Billing', 't-teal'],
  ['tag', 'Add tag', 'refund', 't-pink'],
];
---
<Stage w={560} h={400} label="An opendesk automation rule that routes refund emails to the billing team, and an SLA timer.">
  <div class="app-window left-[28px] top-[28px] w-[330px] h-[344px]" data-seq data-hold="3600">
    <div class="flex items-center gap-2 border-b border-line px-4 py-3">
      <span class="t-amber tint-bg inline-flex size-6 items-center justify-center rounded-[5px]"><Icon name="zap" size={13} /></span>
      <span class="text-[12.5px] font-semibold text-fg">Refunds to billing</span>
      <span class="ml-auto inline-flex items-center gap-1.5 text-[10.5px] text-muted"><span class="size-1.5 rounded-full bg-ok"></span>On</span>
    </div>
    <div class="space-y-3 p-4 text-[12px]">
      <div>
        <div class="font-mono text-[10px] uppercase tracking-[0.08em] text-subtle">When</div>
        <div class="mt-1.5 rounded-[5px] px-3 py-2 text-fg ring-1 ring-line">A ticket is created</div>
      </div>
      <div>
        <div class="font-mono text-[10px] uppercase tracking-[0.08em] text-subtle">If all match</div>
        <div class="mt-1.5 space-y-1.5">
          <div class="rounded-[5px] px-3 py-2 text-muted ring-1 ring-line">Subject <span class="text-fg">contains</span> “refund”</div>
          <div class="rounded-[5px] px-3 py-2 text-muted ring-1 ring-line">Channel <span class="text-fg">is</span> email</div>
        </div>
      </div>
      <div>
        <div class="font-mono text-[10px] uppercase tracking-[0.08em] text-subtle">Then</div>
        <div class="mt-1.5 space-y-1.5">
          {actions.map(([icon, k, v, t], i) => (
            <div class="s-left flex items-center gap-2 rounded-[5px] px-3 py-2 ring-1 ring-line" data-step={i + 1} data-wait={i === 0 ? 900 : 450}>
              <Icon name={icon as 'zap'} size={12} class="text-subtle" /><span class="text-muted">{k}</span><span class={`pill ml-auto ${t}`}>{v}</span><Icon name="check" size={12} class="text-ok" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="float-card s-pop left-[332px] top-[196px] w-[200px] p-4" data-seq data-hold="3600">
    <div class="flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.08em] text-subtle"><Icon name="timer" size={11} />SLA<span class="pill pill-dot t-orange ml-auto normal-case tracking-normal font-sans">High</span></div>
    <div class="mt-3 flex items-baseline justify-between text-[12px]"><span class="text-muted">First reply</span><span class="font-mono text-[11px] text-fg">1h</span></div>
    <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-surface"><div class="s-grow t-blue fill-t h-full w-[34%] rounded-full" data-step="1" data-wait="1600"></div></div>
    <div class="mt-3 flex items-baseline justify-between text-[12px]"><span class="text-muted">Resolution</span><span class="font-mono text-[11px] text-fg">8h</span></div>
    <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-surface"><div class="s-grow h-full w-[12%] rounded-full bg-subtle" data-step="1"></div></div>
    <div class="mt-3 text-[11px] text-subtle">Breaches notify the assignee</div>
  </div>
</Stage>
