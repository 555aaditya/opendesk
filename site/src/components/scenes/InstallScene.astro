---
/** The installer, start to finish, in a terminal. */
import Stage from '../Stage.astro';
const lines = [
  ['·', 'Finding the newest release'],
  ['✓', 'Release files verified against SHA256SUMS'],
  ['✓', 'Wrote .env, docker-compose.yml, Caddyfile and opendesk-ctl'],
  ['·', 'Pulling images'],
  ['✓', 'Containers started, migrations applied'],
  ['✓', 'opendesk is up'],
];
---
<Stage w={600} h={400} label="The opendesk installer running in a terminal.">
  <div class="absolute left-[28px] top-[28px] w-[544px] h-[344px] overflow-hidden rounded-[8px] border border-[#262626] bg-[#0a0a0a] font-mono text-[12px] leading-[1.95]" data-seq data-hold="4200">
    <div class="flex h-9 items-center gap-1.5 border-b border-white/10 px-4">
      <span class="size-2.5 rounded-[3px] bg-white/15"></span><span class="size-2.5 rounded-full bg-white/15"></span>
      <span class="ml-2 text-[10.5px] text-white/40">~/opendesk</span>
    </div>
    <div class="p-5">
      <div class="flex gap-2"><span class="text-white/40">$</span><span class="s-fade text-white" data-step="1" data-wait="500" data-stream="60">curl -fsSL https://opendesk.sh/install.sh | sh</span></div>
      <div class="mt-2 text-white/60">
        {lines.map(([m, t], i) => (
          <div class="s-fade" data-step={i + 2} data-wait={i === 3 ? 1100 : 420}><span class={m === '✓' ? 'text-[#22c55e]' : 'text-white/35'}>{m}</span> {t}</div>
        ))}
        <div class="s-fade mt-3 text-white" data-step="8" data-wait="500">  Open https://desk.example.com<span class="od-caret !bg-white"></span></div>
      </div>
    </div>
  </div>
</Stage>
