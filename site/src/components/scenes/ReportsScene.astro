---
/** The overview report: medians, volume by day and satisfaction. */
import Stage from '../Stage.astro';
const bars = [38, 52, 46, 61, 58, 72, 44, 66, 78, 70, 84, 62, 74, 88];
---
<Stage w={560} h={400} label="opendesk reports: median first reply, tickets solved and CSAT, with a chart of tickets per day.">
  <div class="app-window left-[28px] top-[28px] w-[504px] h-[400px]">
    <div class="flex items-center gap-2 border-b border-line px-5 py-3">
      <span class="text-[12.5px] font-semibold text-fg">Overview</span>
      <span class="ml-auto inline-flex rounded-[5px] p-0.5 text-[10.5px] ring-1 ring-line"><span class="rounded-[5px] px-2 py-0.5 text-subtle">7d</span><span class="rounded-[5px] bg-surface px-2 py-0.5 text-fg">14d</span><span class="rounded-[5px] px-2 py-0.5 text-subtle">30d</span></span>
    </div>
    <div class="grid grid-cols-3 border-b border-line">
      {[['First reply', '14m', 'median'], ['Solved', '312', '+18%'], ['CSAT', '94%', '211 ratings']].map(([k, v, s], i) => (
        <div class={`px-5 py-4 ${i ? 'border-l border-line' : ''}`}>
          <div class="font-mono text-[10px] uppercase tracking-[0.08em] text-subtle">{k}</div>
          <div class="mt-1.5 text-[24px] font-semibold tracking-[-0.04em] text-fg tabular-nums">{v}</div>
          <div class={`font-mono text-[10px] ${i === 1 ? 'text-ok' : 'text-subtle'}`}>{s}</div>{i === 2 && <div class="mt-2 flex h-1 gap-0.5 overflow-hidden rounded-full"><span class="t-green fill-t w-[86%]"></span><span class="t-amber fill-t w-[8%]"></span><span class="t-red fill-t w-[6%]"></span></div>}
        </div>
      ))}
    </div>
    <div class="px-5 pt-5">
      <div class="flex items-center gap-4 font-mono text-[10px] uppercase tracking-[0.08em] text-subtle"><span>Tickets per day</span><span class="ml-auto inline-flex items-center gap-1.5"><span class="t-blue fill-t size-1.5 rounded-full"></span>Solved</span><span class="inline-flex items-center gap-1.5"><span class="t-blue tint-bg size-1.5 rounded-full"></span>Created</span></div>
      <div class="mt-4 flex h-[150px] items-end gap-[7px]">
        {bars.map((b, i) => (
          <div class="relative flex-1" style={`height:${b + 10}%`}>
            <div class="enter-grow-y t-blue tint-bg absolute inset-0 rounded-[3px]" style={`--d:${i * 40}ms`}></div>
            <div class="enter-grow-y t-blue fill-t absolute inset-x-0 bottom-0 rounded-[3px]" style={`height:${70 + (i % 4) * 6}%;--d:${120 + i * 40}ms`}></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Stage>
