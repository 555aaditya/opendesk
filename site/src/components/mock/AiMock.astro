---
/**
 * AI on a ticket: a German email shown translated, a summary with sentiment, the
 * copilot answering from the knowledge base, and a reply drafted in the team's voice.
 * Everything is a suggestion an agent reviews; nothing is sent by itself.
 */
import Icon from '../Icon.astro';
import Avatar from './Avatar.astro';
---
<div class="ai-mock w-full overflow-hidden rounded-2xl border border-line bg-raised shadow-card" data-live aria-hidden="true">
  <div class="flex h-11 items-center gap-2 border-b border-line px-4">
    <span class="font-mono text-[11px] text-subtle">#1058</span>
    <span class="truncate text-[13px] font-semibold text-fg">Rechnung doppelt abgebucht</span>
    <span class="ml-auto inline-flex h-5 shrink-0 items-center gap-1 rounded-full bg-surface px-2 font-mono text-[10px] text-muted"><Icon name="globe" size={10} />DE → EN</span>
  </div>

  <div class="space-y-3 p-4">
    <!-- Customer message, translated -->
    <div class="flex gap-2.5">
      <Avatar initials="FB" size={24} tone={0} />
      <div class="min-w-0 flex-1">
        <div class="flex items-baseline gap-2 text-[12px]"><span class="font-semibold text-fg">Felix Braun</span><span class="text-subtle">translated from German</span></div>
        <div class="mt-1 text-[12.5px] leading-[1.55] text-fg/90">I was charged twice for October. Can you refund the second payment? This is the second time this has happened.</div>
      </div>
    </div>

    <!-- Summary -->
    <div class="rounded-xl border border-line bg-surface-2 p-3">
      <div class="flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-[0.06em] text-subtle">
        <Icon name="sparkles" size={11} />Summary
        <span class="ml-auto inline-flex items-center gap-1 normal-case tracking-normal font-normal text-muted"><span class="size-1.5 rounded-full bg-warn"></span>Frustrated</span>
      </div>
      <ul class="mt-2 space-y-1 text-[12px] leading-[1.5] text-fg/85">
        <li class="flex gap-2"><span class="mt-[7px] size-1 shrink-0 rounded-full bg-subtle"></span>Duplicate October charge, wants a refund</li>
        <li class="flex gap-2"><span class="mt-[7px] size-1 shrink-0 rounded-full bg-subtle"></span>Second occurrence, see #934</li>
      </ul>
      <div class="mt-2.5 flex flex-wrap gap-1">
        {['billing', 'refund', 'priority: high'].map((t) => <span class="rounded px-1.5 py-0.5 text-[10.5px] text-muted ring-1 ring-line bg-bg">{t}</span>)}
      </div>
    </div>

    <!-- Copilot -->
    <div class="rounded-xl border border-line p-3">
      <div class="flex items-center gap-2 text-[12px] text-muted"><Icon name="chat" size={12} />Can we refund a duplicate charge ourselves?</div>
      <div class="mt-1.5 text-[12px] leading-[1.55] text-fg/90">Yes. Duplicate charges are refunded in full within 5 business days.</div>
      <div class="mt-1.5 inline-flex items-center gap-1 text-[10.5px] text-subtle"><Icon name="fileText" size={10} />Refund policy</div>
    </div>

    <!-- Draft -->
    <div class="rounded-xl border border-fg/70 bg-bg">
      <div class="flex items-center gap-1.5 border-b border-line-soft px-3 h-8 text-[11px] text-subtle">
        <Icon name="sparkles" size={11} class="text-fg" /><span class="text-fg font-medium">Draft</span><span class="truncate">in your voice, in German</span>
        <span class="ml-auto shrink-0 whitespace-nowrap font-mono text-[10px]">3 credits</span>
      </div>
      <div class="px-3 py-2.5 text-[12.5px] leading-[1.6] text-fg">
        <span>Hallo Felix, das tut mir leid. Ich habe die doppelte Zahlung erstattet, sie ist in 5 Werktagen auf Ihrem Konto.</span><span class="ai-caret"></span>
      </div>
      <div class="flex items-center gap-1.5 px-2.5 pb-2.5">
        {['Shorter', 'Friendlier', 'English'].map((t) => <span class="inline-flex h-6 items-center whitespace-nowrap rounded-md px-2 text-[11px] text-muted ring-1 ring-line">{t}</span>)}
        <span class="ml-auto inline-flex h-6 shrink-0 items-center whitespace-nowrap rounded-md bg-fg px-2.5 text-[11px] font-medium text-bg">Use draft</span>
      </div>
    </div>
  </div>
</div>
<style>
  .ai-caret { display: inline-block; width: 1.5px; height: 14px; margin-left: 1px; vertical-align: -2px; background: var(--fg); animation: ai-caret 1s steps(1) infinite; }
  @keyframes ai-caret { 50% { opacity: 0; } }
</style>
