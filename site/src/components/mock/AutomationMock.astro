---
/** A rule, the way the automation builder reads: trigger, conditions, actions. */
import Icon from '../Icon.astro';
const blocks = [
  { k: 'When', items: [['Ticket created', 'zap']] },
  { k: 'If', items: [['Subject contains “invoice”', 'filter'], ['Channel is email', 'mail']] },
  { k: 'Then', items: [['Assign team Billing', 'users'], ['Set priority High', 'alarm'], ['Add tag billing', 'tag']] },
] as const;
---
<div class="w-full rounded-2xl border border-line bg-raised p-4 shadow-card" aria-hidden="true">
  <div class="flex items-center gap-2">
    <span class="text-[13px] font-semibold text-fg">Billing to finance team</span>
    <span class="ml-auto inline-flex h-5 items-center gap-1.5 rounded-full bg-surface px-2 text-[10.5px] text-muted"><span class="size-1.5 rounded-full bg-ok"></span>Enabled</span>
    <span class="font-mono text-[10.5px] text-subtle">ran 1,284×</span>
  </div>
  <div class="mt-4 space-y-3">
    {blocks.map((b, i) => (
      <div class="relative flex gap-3">
        <div class="flex w-10 shrink-0 flex-col items-center">
          <span class="flex h-6 w-10 items-center justify-center rounded-md bg-fg font-mono text-[10px] uppercase tracking-wider text-bg">{b.k}</span>
          {i < blocks.length - 1 && <span class="mt-1 w-px flex-1 bg-line"></span>}
        </div>
        <div class="flex flex-1 flex-wrap gap-1.5 pb-1">
          {b.items.map(([label, icon]) => (
            <span class="inline-flex h-7 items-center gap-1.5 rounded-lg bg-surface-2 px-2.5 text-[12px] text-fg ring-1 ring-line"><Icon name={icon} size={12} class="text-subtle" />{label}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
