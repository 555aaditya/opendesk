---
/** The public help center: search with instant article results. */
import Icon from '../Icon.astro';
const results = [
  { t: 'Export invoices as CSV', c: 'Billing', v: '1.2k views' },
  { t: 'Change your billing email', c: 'Billing', v: '860 views' },
  { t: 'Download past receipts', c: 'Billing', v: '412 views' },
];
---
<div class="w-full overflow-hidden rounded-2xl border border-line bg-raised shadow-card" aria-hidden="true">
  <div class="border-b border-line bg-surface-2 px-4 pb-4 pt-3.5">
    <div class="font-mono text-[10.5px] text-subtle">help.northwind.io</div>
    <div class="mt-2 text-[15px] font-semibold text-fg">How can we help?</div>
    <div class="mt-3 flex h-9 items-center gap-2 rounded-lg bg-bg px-3 text-[12.5px] text-fg ring-1 ring-fg/80">
      <Icon name="search" size={13} class="text-subtle" />invoice<span class="kb-caret"></span>
    </div>
  </div>
  <ul class="divide-y divide-line-soft">
    {results.map((r, i) => (
      <li class={`flex items-center gap-3 px-4 py-2.5 ${i === 0 ? 'bg-surface' : ''}`}>
        <Icon name="fileText" size={14} class="text-subtle" />
        <div class="min-w-0">
          <div class="truncate text-[12.5px] font-medium text-fg">{r.t}</div>
          <div class="text-[11px] text-subtle">{r.c} · {r.v}</div>
        </div>
        <Icon name="chevronRight" size={13} class="ml-auto text-subtle" />
      </li>
    ))}
  </ul>
</div>
<style>
  .kb-caret { display: inline-block; width: 1.5px; height: 14px; margin-left: -6px; background: var(--fg); animation: kb-caret 1s steps(1) infinite; }
  @keyframes kb-caret { 50% { opacity: 0; } }
</style>
