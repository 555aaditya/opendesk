---
/** Mailboxes in settings: each one's inbound route and how replies leave. */
import Icon from '../Icon.astro';
const boxes = [
  ['support@northwind.io', 'Forwarding', 'acme-x7k2@in.opendesk.sh', 'ok'],
  ['billing@northwind.io', 'Google', 'Connected with OAuth', 'ok'],
  ['sales@northwind.io', 'Microsoft 365', 'Connected with OAuth', 'ok'],
  ['ops@northwind.io', 'IMAP and SMTP', 'mail.northwind.io:993', 'warn'],
] as const;
---
<div class="space-y-2" aria-hidden="true">
  {boxes.map(([m, k, d, tone]) => (
    <div class="flex items-center gap-3 rounded-xl border border-line bg-raised px-3.5 py-2.5">
      <span class="flex size-7 shrink-0 items-center justify-center rounded-lg bg-surface text-fg"><Icon name="mail" size={14} /></span>
      <div class="min-w-0">
        <div class="truncate text-[13px] font-medium text-fg">{m}</div>
        <div class="truncate font-mono text-[11px] text-subtle">{d}</div>
      </div>
      <span class="ml-auto shrink-0 inline-flex items-center gap-1.5 rounded-full bg-surface px-2 py-0.5 text-[11px] text-muted"><span class={`size-1.5 rounded-full ${tone === 'warn' ? 'bg-warn' : 'bg-ok'}`}></span>{k}</span>
    </div>
  ))}
</div>
