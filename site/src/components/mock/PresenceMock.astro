---
/** Collision detection: who is on a ticket, and who is replying, in real time. */
import Avatar from './Avatar.astro';
const people = [
  { i: 'LH', name: 'Lena Hart', state: 'Replying', tone: 1 },
  { i: 'MO', name: 'Marco Oliveira', state: 'Viewing', tone: 0 },
  { i: 'LK', name: 'Lisa Kim', state: 'Idle', tone: 3 },
];
---
<div class="w-full rounded-2xl border border-line bg-raised p-4 shadow-card" data-live aria-hidden="true">
  <div class="flex items-center gap-2 text-[12.5px]">
    <span class="font-mono text-[11px] text-subtle">#1042</span>
    <span class="truncate font-medium text-fg">Can’t export invoices to CSV</span>
  </div>
  <div class="mt-3 space-y-2">
    {people.map((p, i) => (
      <div class="flex items-center gap-2.5">
        <span class="relative">
          <Avatar initials={p.i} size={26} tone={p.tone} />
          <span class={`absolute -bottom-0.5 -right-0.5 size-2.5 rounded-full ring-2 ring-raised ${p.state === 'Idle' ? 'bg-subtle' : 'bg-ok'}`}></span>
        </span>
        <span class="text-[12.5px] text-fg">{p.name}</span>
        <span class={`ml-auto inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[11px] ${i === 0 ? 'bg-fg text-bg' : 'bg-surface text-muted'}`}>
          {i === 0 && <span class="pres-dots inline-flex gap-[2px]"><i></i><i></i><i></i></span>}{p.state}
        </span>
      </div>
    ))}
  </div>
  <div class="mt-3 rounded-lg bg-surface-2 px-3 py-2 text-[11.5px] text-muted ring-1 ring-line">Lena is already replying to this ticket.</div>
</div>
<style>
  .pres-dots i { width: 3px; height: 3px; border-radius: 99px; background: currentColor; animation: pres 1.1s ease-in-out infinite; }
  .pres-dots i:nth-child(2) { animation-delay: 0.15s; }
  .pres-dots i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes pres { 30% { transform: translateY(-2px); } }
</style>
