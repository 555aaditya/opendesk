---
/** SLA policies by priority, with the clocks they put on tickets. */
const rows = [
  { p: 'Urgent', fr: '15m', res: '4h', left: 'Breached', pct: 100, tone: 'bad' },
  { p: 'High', fr: '1h', res: '8h', left: '12m left', pct: 80, tone: 'warn' },
  { p: 'Normal', fr: '4h', res: '24h', left: '3h 10m', pct: 21, tone: 'ok' },
] as const;
const dot = { bad: 'bg-bad', warn: 'bg-warn', ok: 'bg-ok' } as const;
---
<div class="w-full rounded-2xl border border-line bg-raised p-4 shadow-card" aria-hidden="true">
  <div class="grid grid-cols-[1fr_auto_auto] gap-x-4 pb-2 text-[10.5px] font-medium uppercase tracking-[0.08em] text-subtle">
    <span>Policy</span><span>First reply</span><span>Resolve</span>
  </div>
  <div class="divide-y divide-line-soft">
    {rows.map((r) => (
      <div class="py-2.5">
        <div class="grid grid-cols-[1fr_auto_auto] items-center gap-x-4 text-[12.5px]">
          <span class="font-medium text-fg">{r.p}</span>
          <span class="w-[62px] font-mono text-[11.5px] text-muted">{r.fr}</span>
          <span class="w-[44px] font-mono text-[11.5px] text-muted">{r.res}</span>
        </div>
        <div class="mt-2 flex items-center gap-2">
          <div class="h-1 flex-1 overflow-hidden rounded-full bg-surface"><div class="h-full rounded-full bg-fg" style={`width:${r.pct}%`}></div></div>
          <span class="inline-flex w-[76px] items-center justify-end gap-1.5 font-mono text-[10.5px] text-muted"><span class={`size-1.5 rounded-full ${dot[r.tone]}`}></span>{r.left}</span>
        </div>
      </div>
    ))}
  </div>
</div>
