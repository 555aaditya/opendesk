---
/**
 * The inbox, built in HTML and CSS: views, the ticket list, an open ticket with
 * live presence and an internal note, and the details rail. It reflows like the
 * app does: the rail drops below xl, the sidebar below lg and the list below md,
 * so a phone sees the open ticket the way the app shows it on a phone.
 *
 * Loops (a ticket arriving over the socket, a teammate typing, the reply being
 * written) only run while the mock is on screen.
 */
import Icon from '../Icon.astro';
import Avatar from './Avatar.astro';

const views = [
  { icon: 'inbox', label: 'Unassigned', n: 4 },
  { icon: 'user', label: 'Mine', n: 7, active: true },
  { icon: 'eye', label: 'Open', n: 23 },
  { icon: 'clock', label: 'Pending', n: 5 },
  { icon: 'checkCircle', label: 'Solved', n: null },
] as const;

type Row = { who: string; initials: string; subject: string; preview: string; time: string; channel: 'mail' | 'chat'; status: 'open' | 'pending' | 'solved'; sla?: string; slaTone?: 'warn' | 'bad'; unread?: boolean; selected?: boolean; num: number };
const incoming: Row = { who: 'Priya Raman', initials: 'PR', subject: 'Widget not loading on checkout', preview: 'Since this morning the chat bubble…', time: 'now', channel: 'chat', status: 'open', unread: true, num: 1043 };
const rows: Row[] = [
  { who: 'Jonas Weber', initials: 'JW', subject: 'Can’t export invoices to CSV', preview: 'The export button spins and then…', time: '4m', channel: 'mail', status: 'open', sla: '12m', slaTone: 'warn', selected: true, num: 1042 },
  { who: 'Ana Souza', initials: 'AS', subject: 'Change billing email', preview: 'Could you move invoices to finance@…', time: '18m', channel: 'mail', status: 'open', unread: true, num: 1041 },
  { who: 'Kenji Mori', initials: 'KM', subject: 'SSO with Okta?', preview: 'We use Okta for everything, is OIDC…', time: '42m', channel: 'chat', status: 'pending', num: 1039 },
  { who: 'Sara Lindqvist', initials: 'SL', subject: 'Refund for duplicate charge', preview: 'I was charged twice on the 3rd.', time: '1h', channel: 'mail', status: 'open', sla: 'Breached', slaTone: 'bad', num: 1037 },
  { who: 'Diego Alvarez', initials: 'DA', subject: 'API rate limits for bulk import', preview: 'What is the limit per minute for…', time: '2h', channel: 'mail', status: 'pending', num: 1035 },
  { who: 'Mei Chen', initials: 'MC', subject: 'Thanks, all working now', preview: 'That fixed it, appreciate the help!', time: '3h', channel: 'chat', status: 'solved', num: 1031 },
];
const statusDot = { open: 'bg-fg', pending: 'bg-subtle', solved: 'bg-transparent ring-1 ring-inset ring-subtle' } as const;
---
<div class="inbox-mock relative rounded-[18px] border border-line bg-raised shadow-card overflow-hidden text-left select-none" data-live aria-hidden="true">
  <!-- Window bar -->
  <div class="flex h-10 items-center gap-3 border-b border-line bg-surface-2 px-4">
    <div class="flex gap-1.5">
      <span class="size-2.5 rounded-full bg-line"></span><span class="size-2.5 rounded-full bg-line"></span><span class="size-2.5 rounded-full bg-line"></span>
    </div>
    <div class="mx-auto flex h-6 w-full max-w-[280px] items-center justify-center gap-1.5 rounded-md bg-bg px-3 font-mono text-[11px] text-subtle ring-1 ring-line">
      <Icon name="lock" size={10} />app.opendesk.sh/inbox/mine
    </div>
    <div class="w-[42px]"></div>
  </div>

  <div class="flex h-[540px] md:h-[580px]">
    <!-- Sidebar -->
    <aside class="hidden lg:flex w-[208px] shrink-0 flex-col border-r border-line bg-surface-2 px-2.5 py-3">
      <div class="flex items-center gap-2 px-2 pb-3">
        <span class="flex size-6 items-center justify-center rounded-md bg-fg text-bg text-[11px] font-semibold">N</span>
        <span class="text-[13px] font-semibold text-fg">Northwind</span>
        <Icon name="chevronDown" size={13} class="ml-auto text-subtle" />
      </div>
      <div class="mx-1 mb-3 flex h-7 items-center gap-2 rounded-md bg-bg px-2 text-[12px] text-subtle ring-1 ring-line">
        <Icon name="search" size={12} />Search<span class="ml-auto kbd">/</span>
      </div>
      <div class="px-2 pb-1.5 pt-1 text-[10.5px] font-medium uppercase tracking-[0.08em] text-subtle">Views</div>
      {views.map((v) => (
        <div class={`flex h-7 items-center gap-2 rounded-md px-2 text-[12.5px] ${'active' in v && v.active ? 'bg-bg text-fg font-medium ring-1 ring-line' : 'text-muted'}`}>
          <Icon name={v.icon} size={13} />{v.label}
          {v.n !== null && <span class={`ml-auto font-mono text-[11px] tabular-nums ${'active' in v && v.active ? 'text-fg' : 'text-subtle'}`}>{v.n}</span>}
        </div>
      ))}
      <div class="px-2 pb-1.5 pt-4 text-[10.5px] font-medium uppercase tracking-[0.08em] text-subtle">Mailboxes</div>
      {['support@northwind.io', 'billing@northwind.io'].map((m) => (
        <div class="flex h-7 items-center gap-2 rounded-md px-2 text-[12.5px] text-muted truncate"><Icon name="mail" size={13} /><span class="truncate">{m}</span></div>
      ))}
      <div class="flex h-7 items-center gap-2 rounded-md px-2 text-[12.5px] text-muted"><Icon name="chat" size={13} />Live chat<span class="ml-auto size-1.5 rounded-full bg-ok"></span></div>
      <div class="mt-auto flex items-center gap-2 rounded-lg px-2 pt-3 border-t border-line">
        <Avatar initials="LH" size={22} tone={2} />
        <div class="min-w-0">
          <div class="text-[12px] font-medium text-fg leading-4">Lena Hart</div>
          <div class="text-[10.5px] text-subtle leading-4">Online</div>
        </div>
        <Icon name="bell" size={14} class="ml-auto text-subtle" />
      </div>
    </aside>

    <!-- Ticket list -->
    <section class="hidden md:flex w-[300px] lg:w-[316px] shrink-0 flex-col border-r border-line">
      <div class="flex h-12 items-center gap-2 border-b border-line px-4">
        <span class="text-[13.5px] font-semibold text-fg">Mine</span>
        <span class="font-mono text-[11px] tabular-nums text-subtle">7</span>
        <span class="ml-auto inline-flex h-6 items-center gap-1 rounded-md px-1.5 text-[11.5px] text-muted ring-1 ring-line"><Icon name="filter" size={12} />Last message</span>
      </div>
      <div class="relative flex-1 overflow-hidden">
        <div class="mock-list">
          {[incoming, ...rows].map((r, i) => (
            <div class={`relative flex h-[76px] gap-2.5 border-b border-line-soft px-4 py-3 ${r.selected ? 'bg-surface' : ''} ${i === 0 ? 'mock-new' : ''}`}>
              {r.selected && <span class="absolute left-0 top-0 bottom-0 w-[2px] bg-fg"></span>}
              <Avatar initials={r.initials} size={28} tone={i % 4} />
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1.5">
                  <span class={`truncate text-[12.5px] ${r.unread ? 'font-semibold text-fg' : 'font-medium text-fg/85'}`}>{r.who}</span>
                  <Icon name={r.channel} size={11} class="shrink-0 text-subtle" />
                  <span class={`ml-auto shrink-0 font-mono text-[10.5px] tabular-nums ${r.unread ? 'text-fg' : 'text-subtle'}`}>{r.time}</span>
                </div>
                <div class={`mt-0.5 truncate text-[12.5px] ${r.unread ? 'text-fg' : 'text-muted'}`}>{r.subject}</div>
                <div class="mt-1 flex items-center gap-2">
                  <span class="truncate text-[11.5px] text-subtle">{r.preview}</span>
                  {r.sla && (
                    <span class={`ml-auto inline-flex h-[18px] shrink-0 items-center gap-1 rounded px-1.5 font-mono text-[10px] ring-1 ring-line ${r.slaTone === 'bad' ? 'text-bad' : 'text-warn'}`}>
                      <span class={`size-1.5 rounded-full ${r.slaTone === 'bad' ? 'bg-bad' : 'bg-warn'}`}></span>{r.sla}
                    </span>
                  )}
                  {!r.sla && <span class={`ml-auto size-2 shrink-0 rounded-full ${statusDot[r.status]}`}></span>}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Open ticket -->
    <section class="flex min-w-0 flex-1 flex-col">
      <div class="flex min-h-12 items-center gap-3 border-b border-line px-4 md:px-5 py-2">
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-2">
            <span class="font-mono text-[11.5px] text-subtle">#1042</span>
            <span class="truncate text-[13.5px] font-semibold text-fg">Can’t export invoices to CSV</span>
          </div>
        </div>
        <!-- Presence: who else is on this ticket right now -->
        <div class="flex items-center">
          <div class="flex -space-x-1">
            <span class="mock-presence relative rounded-full ring-2 ring-raised"><Avatar initials="LK" size={22} tone={3} /></span>
            <span class="relative rounded-full ring-2 ring-raised"><Avatar initials="MO" size={22} tone={1} /></span>
          </div>
        </div>
        <span class="hidden sm:inline-flex h-6 items-center gap-1.5 rounded-md px-2 text-[11.5px] font-medium text-fg ring-1 ring-line"><span class="size-1.5 rounded-full bg-fg"></span>Open</span>
              </div>

      <div class="relative flex-1 overflow-hidden px-4 md:px-5 py-4 space-y-4">
        <!-- Customer email -->
        <article class="flex gap-3">
          <Avatar initials="JW" size={28} tone={0} />
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline gap-2">
              <span class="text-[12.5px] font-semibold text-fg">Jonas Weber</span>
              <span class="truncate text-[11px] text-subtle">via support@northwind.io</span>
              <span class="ml-auto shrink-0 font-mono text-[10.5px] text-subtle">09:41</span>
            </div>
            <div class="mt-1.5 text-[13px] leading-[1.6] text-fg/90">Hi, the export button on the invoices page spins and then nothing downloads. I need the CSV for our month-end close today. Is something broken?</div>
            <div class="mt-2 inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-[11px] text-muted ring-1 ring-line"><Icon name="paperclip" size={11} />screenshot.png<span class="text-subtle">84 KB</span></div>
          </div>
        </article>

        <!-- Activity -->
        <div class="flex items-center gap-2 pl-10 text-[11px] text-subtle">
          <Icon name="zap" size={11} /><span>Automation <span class="text-muted">Billing to finance team</span> set priority to <span class="text-muted">High</span></span>
        </div>

        <!-- Internal note -->
        <article class="flex gap-3">
          <Avatar initials="MO" size={28} tone={1} />
          <div class="min-w-0 flex-1 rounded-xl border border-dashed border-line bg-surface-2 px-3.5 py-2.5">
            <div class="flex items-baseline gap-2">
              <span class="text-[12.5px] font-semibold text-fg">Marco Oliveira</span>
              <span class="rounded px-1 font-mono text-[9.5px] uppercase tracking-wider text-muted ring-1 ring-line">Internal note</span>
              <span class="ml-auto font-mono text-[10.5px] text-subtle">09:46</span>
            </div>
            <div class="mt-1 text-[12.5px] leading-[1.6] text-muted"><span class="text-fg">@Lena</span> exports over 5k rows time out. The fix ships today, can you send him the workaround?</div>
          </div>
        </article>

        <!-- Typing, from the ticket channel -->
        <div class="mock-typing flex items-center gap-2 pl-10 text-[11.5px] text-subtle">
          <span class="inline-flex gap-[3px]"><i class="dot"></i><i class="dot"></i><i class="dot"></i></span>
          Lisa Kim is viewing · you are replying
        </div>
      </div>

      <!-- Composer -->
      <div class="mx-3 md:mx-5 mb-3 md:mb-4 rounded-xl border border-line bg-bg">
        <div class="flex items-center gap-4 border-b border-line-soft px-3.5 h-9 text-[12px]">
          <span class="relative font-medium text-fg">Reply<span class="absolute -bottom-[11px] left-0 right-0 h-[1.5px] bg-fg"></span></span>
          <span class="text-subtle">Note</span>
          <span class="ml-auto hidden sm:inline-flex items-center gap-1.5 text-[11px] text-subtle"><Icon name="mail" size={11} />jonas@weber.dev</span>
        </div>
        <div class="px-3.5 pt-2.5 pb-1 min-h-[64px] text-[13px] leading-[1.6] text-fg">
          <span>Hi Jonas, sorry about that. Until the fix lands today, filter the list by month and export each one separately.</span><span class="mock-caret"></span>
        </div>
        <div class="flex items-center gap-1.5 px-2.5 pb-2.5">
          <span class="inline-flex size-7 items-center justify-center rounded-md text-subtle"><Icon name="paperclip" size={14} /></span>
          <span class="inline-flex h-7 items-center gap-1.5 whitespace-nowrap rounded-md px-1.5 text-[11.5px] text-subtle"><span class="kbd">/</span>Saved replies</span>
          <span class="ml-auto inline-flex h-7 items-center gap-1.5 rounded-md bg-fg px-3 text-[12px] font-medium text-bg">Send<span class="hidden sm:inline font-mono text-[10px] opacity-60">⌘↵</span></span>
        </div>
      </div>
    </section>

    <!-- Details rail -->
    <aside class="hidden xl:flex w-[232px] shrink-0 flex-col gap-5 border-l border-line bg-surface-2 px-4 py-4 text-[12px]">
      <div>
        <div class="flex items-center gap-2.5">
          <Avatar initials="JW" size={32} tone={0} />
          <div class="min-w-0">
            <div class="text-[13px] font-semibold text-fg">Jonas Weber</div>
            <div class="truncate text-[11.5px] text-subtle">jonas@weber.dev</div>
          </div>
        </div>
        <div class="mt-3 flex items-center gap-1.5 text-[11.5px] text-muted"><Icon name="layers" size={12} />Weber Logistik · 6 tickets</div>
      </div>
      <dl class="space-y-2.5">
        {[
          ['Status', 'Open'],
          ['Priority', 'High'],
          ['Assignee', 'Lena Hart'],
          ['Team', 'Billing'],
        ].map(([k, v]) => (
          <div class="flex items-center justify-between gap-2">
            <dt class="text-subtle">{k}</dt>
            <dd class="text-fg font-medium">{v}</dd>
          </div>
        ))}
        <div class="flex items-center justify-between gap-2">
          <dt class="text-subtle">Tags</dt>
          <dd class="flex gap-1"><span class="rounded px-1.5 py-0.5 text-[10.5px] text-muted ring-1 ring-line">export</span><span class="rounded px-1.5 py-0.5 text-[10.5px] text-muted ring-1 ring-line">billing</span></dd>
        </div>
      </dl>
      <div class="rounded-lg border border-line bg-bg p-3">
        <div class="flex items-center justify-between">
          <span class="text-subtle">First response</span>
          <span class="font-mono text-[11px] text-warn">12m left</span>
        </div>
        <div class="mt-2 h-1 overflow-hidden rounded-full bg-surface"><div class="mock-sla h-full w-[78%] rounded-full bg-fg"></div></div>
        <div class="mt-2.5 flex items-center justify-between">
          <span class="text-subtle">Resolution</span>
          <span class="font-mono text-[11px] text-muted">7h 12m</span>
        </div>
        <div class="mt-2 h-1 overflow-hidden rounded-full bg-surface"><div class="h-full w-[22%] rounded-full bg-subtle"></div></div>
      </div>
      <div>
        <div class="text-subtle mb-2">Previous tickets</div>
        {[['#998', 'Seat count on invoice'], ['#871', 'Add a second admin']].map(([n, s]) => (
          <div class="flex items-center gap-2 py-1 text-muted"><span class="font-mono text-[10.5px] text-subtle">{n}</span><span class="truncate">{s}</span><span class="ml-auto size-1.5 rounded-full ring-1 ring-subtle"></span></div>
        ))}
      </div>
    </aside>
  </div>

  <!-- Realtime toast: an event just landed on the socket -->
  <div class="mock-toast absolute right-4 bottom-4 md:right-auto md:left-[calc(208px+16px)] hidden md:flex items-center gap-2.5 rounded-xl border border-line bg-raised px-3 py-2 shadow-card">
    <span class="relative flex size-2"><span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-ok opacity-60"></span><span class="relative size-2 rounded-full bg-ok"></span></span>
    <span class="text-[12px] text-fg"><span class="font-medium">New chat</span> <span class="text-subtle">from Priya Raman</span></span>
    <span class="font-mono text-[10px] text-subtle">ticket.created</span>
  </div>
</div>

<style>
  /* A 12s loop. The list starts one row up; a ticket arrives over the socket and
     the list makes room for it. The toast confirms the event. */
  .mock-list { animation: mock-list 12s cubic-bezier(0.2, 0.8, 0.2, 1) infinite; }
  @keyframes mock-list {
    0%, 22% { transform: translateY(-76px); }
    28%, 94% { transform: none; }
    100% { transform: translateY(-76px); }
  }
  .mock-new { animation: mock-new 12s ease-out infinite; }
  @keyframes mock-new {
    0%, 22% { opacity: 0; }
    28% { opacity: 1; background: var(--surface); }
    60%, 100% { opacity: 1; background: transparent; }
  }
  .mock-toast { animation: mock-toast 12s cubic-bezier(0.2, 0.8, 0.2, 1) infinite; }
  @keyframes mock-toast {
    0%, 24% { opacity: 0; transform: translateY(8px) scale(0.98); }
    29%, 52% { opacity: 1; transform: none; }
    58%, 100% { opacity: 0; transform: translateY(4px); }
  }
  @media (max-width: 1023px) { .mock-toast { left: auto; } }

  .mock-presence { animation: mock-presence 12s ease-out infinite; }
  @keyframes mock-presence {
    0%, 8% { opacity: 0; transform: scale(0.6); }
    12%, 100% { opacity: 1; transform: none; }
  }

  .mock-typing .dot { width: 4px; height: 4px; border-radius: 999px; background: var(--subtle); animation: mock-dot 1.2s ease-in-out infinite; }
  .mock-typing .dot:nth-child(2) { animation-delay: 0.15s; }
  .mock-typing .dot:nth-child(3) { animation-delay: 0.3s; }
  @keyframes mock-dot { 0%, 60%, 100% { transform: none; opacity: 0.45; } 30% { transform: translateY(-2px); opacity: 1; } }

  .mock-caret { display: inline-block; width: 1.5px; height: 15px; margin-left: 1px; vertical-align: -2px; background: var(--fg); animation: mock-caret 1s steps(1) infinite; }
  @keyframes mock-caret { 50% { opacity: 0; } }

  .mock-sla { animation: mock-sla 12s linear infinite; transform-origin: left; }
  @keyframes mock-sla { from { transform: scaleX(0.92); } to { transform: scaleX(1); } }

  @media (prefers-reduced-motion: reduce) {
    .mock-list, .mock-new, .mock-toast, .mock-presence { animation: none !important; }
    .mock-list { transform: none; }
    .mock-toast { opacity: 0; }
  }
</style>
