---
/** The chat widget as a visitor sees it: an agent's reply arriving live, with typing. */
import Avatar from './Avatar.astro';
import Icon from '../Icon.astro';
---
<div class="relative mx-auto w-full max-w-[300px]" data-live aria-hidden="true">
  <div class="overflow-hidden rounded-2xl border border-line bg-raised shadow-card">
    <div class="bg-fg px-4 pb-4 pt-3.5 text-bg">
      <div class="flex items-center gap-2">
        <span class="flex -space-x-1.5">
          <span class="rounded-full ring-2 ring-fg"><Avatar initials="LH" size={22} tone={0} /></span>
          <span class="rounded-full ring-2 ring-fg"><Avatar initials="MO" size={22} tone={3} /></span>
        </span>
        <span class="ml-auto inline-flex items-center gap-1.5 text-[11px] opacity-70"><span class="size-1.5 rounded-full bg-ok"></span>Replies in minutes</span>
      </div>
      <div class="mt-3 text-[15px] font-semibold leading-tight">Hi there, how can we help?</div>
    </div>
    <div class="space-y-2.5 px-3.5 py-3.5 text-[12.5px] leading-[1.5]">
      <div class="ml-auto w-fit max-w-[85%] rounded-2xl rounded-br-md bg-fg px-3 py-2 text-bg">Is there a way to add a second admin?</div>
      <div class="flex items-end gap-2">
        <Avatar initials="LH" size={20} tone={1} />
        <div class="relative max-w-[85%]">
          <div class="chat-reply rounded-2xl rounded-bl-md bg-surface px-3 py-2 text-fg">Yes. Settings, Members, then invite them with the Admin role.</div>
          <div class="chat-typing absolute bottom-0 left-0 flex gap-[3px] rounded-2xl rounded-bl-md bg-surface px-3 py-3"><i></i><i></i><i></i></div>
        </div>
      </div>
    </div>
    <div class="mx-3 mb-3 flex h-9 items-center gap-2 rounded-xl px-3 text-[12px] text-subtle ring-1 ring-line">
      Write a message…<Icon name="send" size={13} class="ml-auto" />
    </div>
  </div>
  <div class="mt-3 ml-auto flex size-11 items-center justify-center rounded-full bg-fg text-bg shadow-card"><Icon name="chat" size={19} /></div>
</div>
<style>
  .chat-reply { animation: chat-reply 7s ease-out infinite; }
  @keyframes chat-reply { 0%, 38% { opacity: 0; transform: translateY(4px); } 44%, 100% { opacity: 1; transform: none; } }
  .chat-typing { animation: chat-typing 7s linear infinite; }
  @keyframes chat-typing { 0%, 8% { opacity: 0; } 10%, 38% { opacity: 1; } 40%, 100% { opacity: 0; } }
  .chat-typing i { width: 4px; height: 4px; border-radius: 99px; background: var(--subtle); animation: chat-dot 1.1s ease-in-out infinite; }
  .chat-typing i:nth-child(2) { animation-delay: 0.15s; }
  .chat-typing i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes chat-dot { 30% { transform: translateY(-2px); } }
  @media (prefers-reduced-motion: reduce) { .chat-typing { display: none; } .chat-reply { opacity: 1; } }
</style>
