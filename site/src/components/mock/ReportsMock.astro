---
/** Overview report: created vs solved by day, and the medians teams steer by. */
const days = [
  [42, 38], [51, 47], [47, 49], [63, 55], [58, 61], [29, 31], [24, 22],
  [55, 50], [61, 64], [57, 53], [66, 62], [60, 63], [31, 30], [22, 25],
];
const max = 70;
---
<div class="w-full rounded-2xl border border-line bg-raised p-4 shadow-card" aria-hidden="true">
  <div class="grid grid-cols-3 gap-3">
    {[['First reply p50', '38m'], ['Resolution p50', '5.2h'], ['CSAT', '4.7']].map(([k, v]) => (
      <div>
        <div class="text-[10.5px] text-subtle">{k}</div>
        <div class="mt-0.5 text-[20px] font-semibold tracking-[-0.03em] text-fg tabular-nums">{v}</div>
      </div>
    ))}
  </div>
  <div class="mt-4 flex h-[92px] items-end gap-[5px]">
    {days.map(([c, s], i) => (
      <div class="flex h-full flex-1 items-end gap-[2px]">
        <span class="rep-bar flex-1 rounded-[2px] bg-fg" style={`height:${(c / max) * 100}%;--d:${i * 40}ms`}></span>
        <span class="rep-bar flex-1 rounded-[2px] bg-line" style={`height:${(s / max) * 100}%;--d:${i * 40 + 20}ms`}></span>
      </div>
    ))}
  </div>
  <div class="mt-3 flex items-center gap-4 text-[11px] text-subtle">
    <span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-[2px] bg-fg"></span>Created</span>
    <span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-[2px] bg-line"></span>Solved</span>
    <span class="ml-auto font-mono">Last 14 days</span>
  </div>
</div>
<style>
  .rep-bar { transform-origin: bottom; transition: transform 900ms cubic-bezier(0.2, 0.8, 0.2, 1) var(--d, 0ms); }
  :global(.js) .reveal:not(.is-in) .rep-bar { transform: scaleY(0.05); }
</style>
