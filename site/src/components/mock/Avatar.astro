---
/** Initials avatar in four monochrome tones, so a list reads as different people without colour. */
interface Props {
  initials: string;
  size?: number;
  tone?: number;
}
const { initials, size = 28, tone = 0 } = Astro.props;
const tones = [
  'bg-surface text-fg ring-1 ring-inset ring-line',
  'bg-fg text-bg',
  'bg-[color-mix(in_oklab,var(--fg)_55%,var(--bg))] text-bg',
  'bg-bg text-fg ring-1 ring-inset ring-fg/40',
];
---
<span
  class={`inline-flex shrink-0 items-center justify-center rounded-full font-semibold ${tones[tone % tones.length]}`}
  style={`width:${size}px;height:${size}px;font-size:${Math.max(9, Math.round(size * 0.36))}px;letter-spacing:0.01em`}
>{initials}</span>
