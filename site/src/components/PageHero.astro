---
/** The top of an inner page: label, a semibold headline and one paragraph, on the module grid. */
interface Props {
  label: string;
  title: string;
  lede?: string;
}
const { label, title, lede } = Astro.props;
---
<section class="border-b border-line">
  <div class="container-page pt-14 pb-14 md:pt-24 md:pb-20">
    <div class="rise label flex items-center gap-2.5"><span class="dot"></span><span class="text-fg">{label}</span></div>
    <h1 class="rise h-hero mt-6 max-w-4xl" style="--d:50ms" set:html={title} />
    {lede && <p class="rise lede mt-6 max-w-2xl" style="--d:100ms">{lede}</p>}
    <div class="rise" style="--d:150ms"><slot /></div>
  </div>
</section>
