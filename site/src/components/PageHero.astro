---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: 'left' | 'center';
}
const { eyebrow, title, lede, align = 'left' } = Astro.props;
const center = align === 'center';
---
<section class="relative overflow-hidden border-b border-line">
  <div class="pointer-events-none absolute inset-0 bg-grid fade-mask opacity-70" aria-hidden="true"></div>
  <div class={`container-page relative pt-16 pb-14 md:pt-24 md:pb-20 ${center ? 'text-center' : ''}`}>
    <div class={center ? 'mx-auto max-w-3xl' : 'max-w-3xl'}>
      {eyebrow && <div class="rise eyebrow">{eyebrow}</div>}
      <h1 class="rise display mt-5 text-[40px] sm:text-[56px] md:text-[68px] text-fg" style="--d:50ms" set:html={title} />
      {lede && <p class={`rise lede mt-6 text-[17px] md:text-[19px] leading-[1.55] max-w-2xl ${center ? 'mx-auto' : ''}`} style="--d:100ms">{lede}</p>}
      <div class="rise" style="--d:150ms"><slot /></div>
    </div>
  </div>
</section>
