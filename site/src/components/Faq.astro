---
/** Questions as an accordion of hairline rows. Native <details>, so it works without JS. */
import Icon from './Icon.astro';
interface Props {
  items: { q: string; a: string }[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---
<div class={`modules ${className}`}>
  {items.map((f, i) => (
    <details class="faq group" name="faq" open={i === 0}>
      <summary class="flex cursor-pointer list-none items-center gap-6 px-5 py-5 md:px-7 text-[16px] font-medium tracking-[-0.01em] text-fg transition-colors hover:bg-surface-2 [&::-webkit-details-marker]:hidden">
        <span class="font-mono text-[11.5px] tabular-nums text-subtle">{String(i + 1).padStart(2, '0')}</span>
        <span class="flex-1">{f.q}</span>
        <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-[5px] ring-1 ring-line text-subtle transition-colors group-open:text-fg">
          <Icon name="plus" size={14} class="transition-transform duration-300 group-open:rotate-45" />
        </span>
      </summary>
      <div class="faq-body grid">
        <p class="overflow-hidden px-5 pb-6 pl-[3.6rem] md:px-7 md:pl-[4.6rem] max-w-3xl text-[15px] leading-relaxed text-muted">{f.a}</p>
      </div>
    </details>
  ))}
</div>

<style>
  /* Opening slides the answer down instead of jumping. */
  @supports (interpolate-size: allow-keywords) {
    .faq { interpolate-size: allow-keywords; }
    .faq::details-content { height: 0; overflow: clip; transition: height 360ms cubic-bezier(0.16, 1, 0.3, 1), content-visibility 360ms allow-discrete; }
    .faq[open]::details-content { height: auto; }
  }
  @media (prefers-reduced-motion: reduce) {
    .faq::details-content { transition: none; }
  }
</style>
