---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { LINKS, EMAILS } from '../lib/site';

const cols = [
  {
    title: 'Product',
    links: [
      { href: '/features/#inbox', label: 'Shared inbox' },
      { href: '/features/#chat', label: 'Live chat' },
      { href: '/features/#ai', label: 'AI' },
      { href: '/features/#knowledge-base', label: 'Knowledge base' },
      { href: '/features/#automations', label: 'Automations and SLAs' },
      { href: '/features/#reports', label: 'Reports' },
      { href: '/features/#api', label: 'API and webhooks' },
      { href: '/pricing/', label: 'Pricing' },
    ],
  },
  {
    title: 'Open source',
    links: [
      { href: '/self-hosting/', label: 'Self-hosting' },
      { href: '/open-source/', label: 'Why open source' },
      { href: LINKS.github, label: 'GitHub' },
      { href: '/changelog/', label: 'Changelog' },
      { href: `${LINKS.docs}/contributing/`, label: 'Contributing' },
    ],
  },
  {
    title: 'Developers',
    links: [
      { href: LINKS.docs, label: 'Documentation' },
      { href: `${LINKS.docs}/api/`, label: 'API overview' },
      { href: LINKS.apiReference, label: 'API reference' },
      { href: `${LINKS.docs}/api/webhooks/`, label: 'Webhooks' },
      { href: `${LINKS.docs}/api/realtime/`, label: 'Realtime' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/blog/', label: 'Blog' },
      { href: '/security/', label: 'Security' },
      { href: '/contact/', label: 'Contact' },
      { href: '/privacy/', label: 'Privacy' },
      { href: '/terms/', label: 'Terms' },
    ],
  },
];
const year = new Date().getFullYear();
---
<footer class="mt-auto border-t border-line">
  <div class="container-page py-14 md:py-16">
    <div class="modules lg:grid-cols-[1.5fr_repeat(4,1fr)]">
      <div class="flex flex-col p-6 md:p-8">
        <a href="/" aria-label="opendesk home" class="inline-block w-fit text-fg"><Logo class="h-[20px] w-auto" /></a>
        <p class="mt-5 max-w-[260px] text-[14px] leading-relaxed text-muted">The open-source helpdesk. Run it on our cloud or on your own servers. Same code either way.</p>
        <div class="mt-8 lg:mt-auto flex items-center gap-0.5 rounded-[6px] p-0.5 w-fit ring-1 ring-line" role="radiogroup" aria-label="Theme" data-theme-switch>
          {[
            { v: 'light', icon: 'sun', label: 'Light theme' },
            { v: 'dark', icon: 'moon', label: 'Dark theme' },
            { v: 'system', icon: 'monitor', label: 'System theme' },
          ].map((o) => (
            <button type="button" role="radio" aria-checked="false" data-value={o.v} aria-label={o.label}
              class="inline-flex size-7 items-center justify-center rounded-[5px] text-subtle transition-colors hover:text-fg aria-checked:bg-surface aria-checked:text-fg">
              <Icon name={o.icon as 'sun'} size={14} />
            </button>
          ))}
        </div>
      </div>
      <div class="grid grid-cols-2 gap-px bg-line sm:grid-cols-4 lg:contents">
        {cols.map((c) => (
          <div class="bg-bg p-6 md:p-8">
            <div class="label">{c.title}</div>
            <ul class="mt-5 space-y-2.5">
              {c.links.map((l) => (
                <li><a href={l.href} class="text-[14px] text-body transition-colors hover:text-fg">{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <div class="mt-6 flex flex-col gap-3 px-1 font-mono text-[11.5px] uppercase tracking-[0.06em] text-subtle sm:flex-row sm:items-center sm:justify-between">
      <div>© {year} opendesk · Apache-2.0</div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href={`mailto:${EMAILS.hello}`} class="normal-case tracking-normal hover:text-fg">{EMAILS.hello}</a>
        <a href={LINKS.github} class="hover:text-fg">GitHub</a>
        <a href="/blog/rss.xml" class="hover:text-fg">RSS</a>
      </div>
    </div>
  </div>
</footer>

<script>
  import { applyTheme, currentTheme, type Theme } from '../lib/theme';

  const group = document.querySelector<HTMLElement>('[data-theme-switch]');
  const sync = () => {
    const t = currentTheme();
    group?.querySelectorAll<HTMLButtonElement>('[data-value]').forEach((b) => {
      b.setAttribute('aria-checked', String(b.dataset.value === t));
    });
  };
  sync();
  document.addEventListener('od:theme', sync);
  group?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-value]');
    if (b) applyTheme(b.dataset.value as Theme);
  });
</script>
