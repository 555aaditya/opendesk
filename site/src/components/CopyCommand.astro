---
/** A one-line shell command with a copy button. `tone="inverse"` sits on dark bands. */
import Icon from './Icon.astro';
import { LINKS } from '../lib/site';

interface Props {
  command?: string;
  class?: string;
  tone?: 'default' | 'inverse';
}
const { command = LINKS.install, class: className = '', tone = 'default' } = Astro.props;
const skin = tone === 'inverse'
  ? 'bg-white/[0.06] ring-white/15 text-white'
  : 'bg-surface-2 ring-line text-fg';
---
<div class={`group/copy flex h-11 min-w-0 items-center gap-3 rounded-[6px] pl-4 pr-1.5 ring-1 ${skin} ${className}`} data-copy={command}>
  <span class={`select-none font-mono text-[13px] ${tone === 'inverse' ? 'text-white/45' : 'text-subtle'}`}>$</span>
  <code class="min-w-0 flex-1 truncate font-mono text-[13px]">{command}</code>
  <button type="button" class={`inline-flex size-8 shrink-0 items-center justify-center rounded-[5px] transition-colors ${tone === 'inverse' ? 'text-white/60 hover:bg-white/10 hover:text-white' : 'text-muted hover:bg-bg hover:text-fg'}`} aria-label="Copy command" data-copy-button>
    <Icon name="copy" size={15} class="[.is-copied_&]:hidden" />
    <Icon name="check" size={15} class="hidden [.is-copied_&]:block" />
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-copy]').forEach((box) => {
    box.querySelector('[data-copy-button]')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(box.dataset.copy ?? '');
        box.classList.add('is-copied');
        setTimeout(() => box.classList.remove('is-copied'), 1600);
      } catch {
        // Clipboard can be refused; the command stays selectable.
      }
    });
  });
</script>
