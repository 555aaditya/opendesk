---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, lede, align = 'left', class: className = '' } = Astro.props;
---
<div class={`reveal ${align === 'center' ? 'mx-auto text-center max-w-2xl' : 'max-w-2xl'} ${className}`}>
  {eyebrow && <div class="eyebrow">{eyebrow}</div>}
  <h2 class="display mt-4 text-[34px] sm:text-[44px] md:text-[52px] text-fg" set:html={title} />
  {lede && <p class="lede mt-5 text-[17px] md:text-[18.5px] leading-[1.6]">{lede}</p>}
  <slot />
</div>
