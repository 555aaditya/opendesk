#!/bin/sh
# Node naming for the release (sourced by bin/realtime on start).
#
# Single node (no CLUSTER_DNS): distribution stays off, nothing listens beyond PORT.
#
# Clustered (CLUSTER_DNS set, ECS service discovery): each task names itself
# realtime@<its private IP>, which is what Cluster.Strategy.DNSPoll derives from
# the A records it polls, and listens for distribution on a fixed port range so
# the security group can allow it (epmd 4369 plus 9100-9155 by default).
# RELEASE_COOKIE must be the same secret on every node. A RELEASE_NODE or
# distribution ports already set by an entrypoint are kept.

if [ -n "${CLUSTER_DNS}" ]; then
  if [ -z "${RELEASE_COOKIE}" ]; then
    echo "RELEASE_COOKIE is required when CLUSTER_DNS is set" >&2
    exit 1
  fi

  case "${RELEASE_NODE}" in
    *@*) ;;
    *)
      if [ -z "${NODE_IP}" ] && [ -n "${ECS_CONTAINER_METADATA_URI_V4}" ] && command -v wget >/dev/null 2>&1; then
        NODE_IP=$(wget -qO- "${ECS_CONTAINER_METADATA_URI_V4}" 2>/dev/null |
          sed -n 's/.*"IPv4Addresses":\["\([0-9.]*\)".*/\1/p')
      fi
      if [ -z "${NODE_IP}" ]; then
        NODE_IP=$(hostname -i 2>/dev/null | awk '{print $1}')
      fi
      if [ -z "${NODE_IP}" ]; then
        echo "cannot determine this node's IP; set NODE_IP" >&2
        exit 1
      fi
      export RELEASE_NODE="realtime@${NODE_IP}"
      ;;
  esac

  export RELEASE_DISTRIBUTION=name

  case "${ELIXIR_ERL_OPTIONS}" in
    *inet_dist_listen_min*) ;;
    *)
      export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS} -kernel inet_dist_listen_min ${DIST_PORT_MIN:-9100} inet_dist_listen_max ${DIST_PORT_MAX:-9155}"
      ;;
  esac
else
  export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
fi
