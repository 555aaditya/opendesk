# The build context is the repo root for every image. Keep it to what the
# Dockerfiles copy: secrets never enter a layer, and a stray node_modules or
# _build never makes a build depend on the machine it ran on.
.git
.github
**/.DS_Store
**/node_modules
**/dist
**/.astro
**/.vite
**/coverage
*.log
bin/
data/
scratch/

# Local configuration and secrets.
.env
.env.*
!.env.example
**/.dev.vars

# Elixir build output; the image compiles its own.
realtime/_build
realtime/deps
realtime/.elixir_ls
realtime/cover
erl_crash.dump

# Parts no image is built from.
site/
docs/
deploy/terraform/
deploy/cloudflare/
deploy/install/
**/.terraform
**/*.tfstate*
