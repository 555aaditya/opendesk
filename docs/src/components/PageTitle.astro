---
import OdIcon from './OdIcon.astro';

const { entry, editUrl } = Astro.locals.starlightRoute;
const { title, description } = entry.data;
// Every docs page also exists as plain Markdown at the same path with `.md`.
const markdownUrl = editUrl ? Astro.url.pathname.replace(/\/$/, '') + '.md' : undefined;
---

<div class="od-title">
  <h1 id="_top">{title}</h1>
  {description && <p class="od-description">{description}</p>}
  {
    editUrl && (
      <div class="od-actions print:hidden">
        <button type="button" class="od-pill" data-copy-markdown={markdownUrl} title="Copy this page as Markdown">
          <OdIcon name="copy" size={13} />
          <span data-label>Copy page</span>
        </button>
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-markdown]').forEach((button) => {
    const label = button.querySelector('[data-label]')!;
    button.addEventListener('click', async () => {
      try {
        const res = await fetch(button.dataset.copyMarkdown!);
        await navigator.clipboard.writeText(await res.text());
        label.textContent = 'Copied';
      } catch {
        label.textContent = 'Copy failed';
      }
      setTimeout(() => (label.textContent = 'Copy page'), 1600);
    });
  });
</script>

<style>
  .od-title h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.08;
    color: var(--od-heading);
  }
  .od-description {
    margin: 0.75rem 0 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--od-muted);
  }
  .od-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .od-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 30px;
    padding-inline: 0.75rem;
    border: 1px solid var(--od-line);
    border-radius: 8px;
    background: var(--od-bg);
    color: var(--od-heading);
    font: inherit;
    font-size: 12.5px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
  }
  .od-pill:hover {
    background: var(--od-soft);
  }
  .od-pill :global(svg) {
    color: var(--od-muted);
  }
</style>
