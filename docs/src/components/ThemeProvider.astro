---
// Light by default; dark only when the reader picked it. Inlined to avoid a flash.
---

<script is:inline>
  window.StarlightThemeProvider = (() => {
    let stored = null;
    try {
      stored = localStorage.getItem('starlight-theme');
    } catch {}
    document.documentElement.dataset.theme = stored === 'dark' ? 'dark' : 'light';
    return { updatePickers() {} };
  })();
</script>
