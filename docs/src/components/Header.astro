---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from './ThemeSelect.astro';
import SectionSwitcher from './SectionSwitcher.astro';
import lockup from '../assets/lockup.svg?raw';

const logo = lockup.replaceAll('#0A0A0A', 'currentColor').replace('<svg ', '<svg aria-hidden="true" ');
---

<div class="od-header">
  <div class="od-header-left">
    <a href="/" class="od-brand" aria-label="opendesk docs home">
      <span class="od-lockup" set:html={logo} />
      <span class="od-brand-docs">Docs</span>
    </a>
    <span class="od-slash" aria-hidden="true"></span>
    <SectionSwitcher />
  </div>
  <div class="od-header-search print:hidden">
    <Search />
  </div>
  <div class="od-header-right print:hidden">
    <a class="od-header-link" href="https://opendesk.sh/">opendesk.sh</a>
    <a class="od-header-cta" href="https://app.opendesk.sh/">Open app</a>
    <a class="od-icon-button" href="https://github.com/opendesk/opendesk" aria-label="GitHub">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3"/></svg>
    </a>
    <ThemeSelect />
  </div>
</div>

<style>
  .od-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 24rem) minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    height: 100%;
  }
  .od-header-left {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .od-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--od-heading);
    text-decoration: none;
    flex-shrink: 0;
  }
  .od-lockup {
    display: inline-flex;
  }
  .od-lockup :global(svg) {
    height: 1.125rem;
    width: auto;
  }
  .od-brand-docs {
    font-size: 15px;
    color: var(--od-muted);
    line-height: 1;
    padding-top: 1px;
  }
  .od-slash {
    width: 1px;
    height: 1.25rem;
    margin-inline: 0.85rem 0.4rem;
    background: var(--od-line);
    transform: rotate(14deg);
    flex-shrink: 0;
  }
  .od-header-search {
    display: flex;
    justify-content: center;
  }
  .od-header-right {
    display: none;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .od-header-link {
    font-size: 14px;
    color: var(--od-muted);
    text-decoration: none;
    padding-inline: 0.5rem;
  }
  .od-header-link:hover {
    color: var(--od-heading);
  }
  .od-header-cta {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding-inline: 0.875rem;
    border-radius: 8px;
    background: var(--od-ink);
    color: var(--od-ink-fg);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    margin-inline-end: 0.25rem;
    transition: opacity 150ms ease;
  }
  .od-header-cta:hover {
    opacity: 0.85;
  }
  .od-icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 8px;
    color: var(--od-muted);
  }
  .od-icon-button:hover {
    color: var(--od-heading);
    background: var(--od-hover);
  }

  @media (max-width: 49.99em) {
    .od-header {
      display: flex;
      justify-content: space-between;
    }
    .od-header-search {
      order: 2;
    }
  }
  @media (max-width: 30em) {
    .od-brand-docs {
      display: none;
    }
  }
  @media (min-width: 50em) {
    .od-header-right {
      display: flex;
    }
  }
  @media (min-width: 50em) and (max-width: 64em) {
    .od-header-link {
      display: none;
    }
  }
</style>

<script>
  // "/" opens search too, unless the reader is typing somewhere.
  window.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
    const open = document.querySelector<HTMLButtonElement>('button[data-open-modal]');
    if (!open || open.disabled) return;
    e.preventDefault();
    open.click();
  });
</script>
