---
import { SECTIONS, sectionFor } from '../lib/sections';
import OdIcon from './OdIcon.astro';

const current = sectionFor(Astro.url.pathname);
---

<od-section-switcher class="od-switcher">
  <button type="button" class="od-switcher-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="od-sections">
    {current && <OdIcon name={current.icon} class="od-switcher-icon" />}
    <span class="od-switcher-label">{current ? current.label : 'Sections'}</span>
    <span class="od-switcher-label od-switcher-short">{current ? current.short : 'Sections'}</span>
    <OdIcon name="updown" size={14} class="od-switcher-icon" />
  </button>
  <div class="od-switcher-panel" id="od-sections" hidden>
    {
      SECTIONS.map((s) => (
        <a href={s.href} class="od-switcher-item" aria-current={s === current ? 'true' : undefined}>
          <span class="od-switcher-item-icon">
            <OdIcon name={s.icon} size={14} />
          </span>
          <span class="od-switcher-item-text">
            <span class="od-switcher-item-name">{s.label}</span>
            <span class="od-switcher-item-desc">{s.text}</span>
          </span>
          {s === current && <OdIcon name="check" size={14} class="od-switcher-check" />}
        </a>
      ))
    }
  </div>
</od-section-switcher>

<script>
  class OdSectionSwitcher extends HTMLElement {
    connectedCallback() {
      const trigger = this.querySelector('button')!;
      const panel = this.querySelector<HTMLElement>('.od-switcher-panel')!;
      const set = (open: boolean) => {
        panel.hidden = !open;
        trigger.setAttribute('aria-expanded', String(open));
      };
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        set(!!panel.hidden);
      });
      document.addEventListener('click', (e) => {
        if (!this.contains(e.target as Node)) set(false);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !panel.hidden) {
          set(false);
          trigger.focus();
        }
      });
    }
  }
  customElements.define('od-section-switcher', OdSectionSwitcher);
</script>

<style>
  .od-switcher {
    position: relative;
    display: block;
    min-width: 0;
  }
  .od-switcher-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2rem;
    padding-inline: 0.5rem;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--od-heading);
    font: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    max-width: 100%;
  }
  .od-switcher-trigger {
    transition: background-color 120ms ease;
  }
  .od-switcher-trigger:hover,
  .od-switcher-trigger[aria-expanded='true'] {
    background: var(--od-hover);
  }
  .od-switcher-label {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .od-switcher-trigger :global(.od-switcher-icon) {
    color: var(--od-muted);
    flex-shrink: 0;
  }
  .od-switcher-panel {
    position: absolute;
    top: calc(100% + 0.4rem);
    inset-inline-start: 0;
    z-index: 30;
    width: 20rem;
    transform-origin: top left;
    animation: od-pop 140ms cubic-bezier(0.2, 0.8, 0.2, 1);
    padding: 0.375rem;
    border: 1px solid var(--od-line);
    border-radius: 12px;
    background: var(--od-popover);
    
  }
  .od-switcher-panel[hidden] {
    display: none;
  }
  .od-switcher-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.5rem 0.625rem;
    border-radius: 8px;
    text-decoration: none;
    color: var(--od-heading);
  }
  .od-switcher-item {
    transition: background-color 120ms ease;
  }
  .od-switcher-item:hover,
  .od-switcher-item[aria-current='true'] {
    background: var(--od-hover);
  }
  .od-switcher-item-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.1rem;
    border: 1px solid var(--od-line);
    border-radius: 7px;
    background: var(--od-bg);
  }
  .od-switcher-item-text {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .od-switcher-item-name {
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.4;
  }
  .od-switcher-item-desc {
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--od-muted);
  }
  .od-switcher-item :global(.od-switcher-check) {
    margin-top: 0.3rem;
    flex-shrink: 0;
  }
  .od-switcher-short {
    display: none;
  }
  @media (max-width: 30em) {
    .od-switcher-label {
      display: none;
    }
    .od-switcher-short {
      display: inline;
    }
    .od-switcher-trigger :global(.od-switcher-icon:first-child) {
      display: none;
    }
  }
</style>
